"ï»¿\u003c!DOCTYPE html PUBLIC \"-//W3C//DTD XHTML 1.0 Transitional//EN\" \"http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd\"\u003e\r\n\u003chtml xmlns=\"http://www.w3.org/1999/xhtml\"\u003e\r\n  \u003chead\u003e\r\n    \u003ctitle\u003eOperations at http://localhost:82/service\u003c/title\u003e\r\n    \u003cstyle\u003eBODY { color: #000000; background-color: white; font-family: Verdana; margin-left: 0px; margin-top: 0px; } #content { margin-left: 30px; font-size: .70em; padding-bottom: 2em; } A:link { color: #336699; font-weight: bold; text-decoration: underline; } A:visited { color: #6699cc; font-weight: bold; text-decoration: underline; } A:active { color: #336699; font-weight: bold; text-decoration: underline; } .heading1 { background-color: #003366; border-bottom: #336699 6px solid; color: #ffffff; font-family: Tahoma; font-size: 26px; font-weight: normal;margin: 0em 0em 10px -20px; padding-bottom: 8px; padding-left: 30px;padding-top: 16px;} pre { font-size:small; background-color: #e5e5cc; padding: 5px; font-family: Courier New; margin-top: 0px; border: 1px #f0f0e0 solid; white-space: pre-wrap; white-space: -pre-wrap; word-wrap: break-word; } table { border-collapse: collapse; border-spacing: 0px; font-family: Verdana;} table th { border-right: 2px white solid; border-bottom: 2px white solid; font-weight: bold; background-color: #cecf9c;} table td { border-right: 2px white solid; border-bottom: 2px white solid; background-color: #e5e5cc;}\u003c/style\u003e\r\n  \u003c/head\u003e\r\n  \u003cbody\u003e\r\n    \u003cdiv id=\"content\"\u003e\r\n      \u003cp class=\"heading1\"\u003eOperations at http://localhost:82/service\u003c/p\u003e\r\n      \u003cp\u003eThis page describes the service operations at this endpoint.\u003c/p\u003e\r\n      \u003ctable\u003e\r\n        \u003ctr\u003e\r\n          \u003cth\u003eUri\u003c/th\u003e\r\n          \u003cth\u003eMethod\u003c/th\u003e\r\n          \u003cth\u003eDescription\u003c/th\u003e\r\n        \u003c/tr\u003e\r\n        \u003ctr\u003e\r\n          \u003ctd\u003e/Admin/ClearStationVirtuals/{application}/{stationIndex}\u003c/td\u003e\r\n          \u003ctd title=\"http://localhost:82/service/Admin/ClearStationVirtuals/{APPLICATION}/{STATIONINDEX}\"\u003e\r\n            \u003ca rel=\"operation\" href=\"help/operations/ClearStationVirtuals\"\u003ePOST\u003c/a\u003e\r\n          \u003c/td\u003e\r\n          \u003ctd\u003eClear virtuals of a stationExample: http://localhost/ServicewTM.svc/Admin/ClearStationVirtuals/FastApp/3\u003c/td\u003e\r\n        \u003c/tr\u003e\r\n        \u003ctr\u003e\r\n          \u003ctd\u003e/Admin/CreateRedactionFieldTemplate/{application}/{dcoID}/{name}\u003c/td\u003e\r\n          \u003ctd title=\"http://localhost:82/service/Admin/CreateRedactionFieldTemplate/{APPLICATION}/{DCOID}/{NAME}\"\u003e\r\n            \u003ca rel=\"operation\" href=\"help/operations/CreateRedactionFieldTemplate\"\u003ePOST\u003c/a\u003e\r\n          \u003c/td\u003e\r\n          \u003ctd\u003eCreate a redaction field template in the Setup DCO.Example: http://localhost/ServicewTM.svc/Admin/CreateRedactionFieldTemplate/FastApp/FastApp/RedactPhone10\u003c/td\u003e\r\n        \u003c/tr\u003e\r\n        \u003ctr\u003e\r\n          \u003ctd\u003e/Admin/DeleteGroup/{application}/{index}\u003c/td\u003e\r\n          \u003ctd title=\"http://localhost:82/service/Admin/DeleteGroup/{APPLICATION}/{INDEX}\"\u003e\r\n            \u003ca rel=\"operation\" href=\"help/operations/DeleteGroup\"\u003ePOST\u003c/a\u003e\r\n          \u003c/td\u003e\r\n          \u003ctd\u003eDelete group. Example: http://localhost/ServicewTM.svc/Admin/DeleteGroup/FastApp/1\u003c/td\u003e\r\n        \u003c/tr\u003e\r\n        \u003ctr\u003e\r\n          \u003ctd\u003e/Admin/DeleteJob/{application}/{workflowIndex}/{jobIndex}\u003c/td\u003e\r\n          \u003ctd title=\"http://localhost:82/service/Admin/DeleteJob/{APPLICATION}/{WORKFLOWINDEX}/{JOBINDEX}\"\u003e\r\n            \u003ca rel=\"operation\" href=\"help/operations/DeleteJob\"\u003ePOST\u003c/a\u003e\r\n          \u003c/td\u003e\r\n          \u003ctd\u003eDelete a job. Example: http://localhost/ServicewTM.svc/Admin/DeleteJob/FastApp/3/2\u003c/td\u003e\r\n        \u003c/tr\u003e\r\n        \u003ctr\u003e\r\n          \u003ctd\u003e/Admin/DeleteNavigatorPanel/{application}\u003c/td\u003e\r\n          \u003ctd title=\"http://localhost:82/service/Admin/DeleteNavigatorPanel/{APPLICATION}\"\u003e\r\n            \u003ca rel=\"operation\" href=\"help/operations/DeleteNavigatorPanel\"\u003ePOST\u003c/a\u003e\r\n          \u003c/td\u003e\r\n          \u003ctd\u003eDelete a Datacap Navigator panel. Example: http://localhost/ServicewTM.svc/Admin/DeleteNavigatorPanel/FastApp\u003c/td\u003e\r\n        \u003c/tr\u003e\r\n        \u003ctr\u003e\r\n          \u003ctd\u003e/Admin/DeleteShortcut/{application}/{shortcutIndex}\u003c/td\u003e\r\n          \u003ctd title=\"http://localhost:82/service/Admin/DeleteShortcut/{APPLICATION}/{SHORTCUTINDEX}\"\u003e\r\n            \u003ca rel=\"operation\" href=\"help/operations/DeleteShortcut\"\u003ePOST\u003c/a\u003e\r\n          \u003c/td\u003e\r\n          \u003ctd\u003eDelete a shortcut. Example: http://localhost/ServicewTM.svc/Admin/DeleteShortcut/FastApp/3\u003c/td\u003e\r\n        \u003c/tr\u003e\r\n        \u003ctr\u003e\r\n          \u003ctd\u003e/Admin/DeleteStation/{application}/{stationIndex}\u003c/td\u003e\r\n          \u003ctd title=\"http://localhost:82/service/Admin/DeleteStation/{APPLICATION}/{STATIONINDEX}\"\u003e\r\n            \u003ca rel=\"operation\" href=\"help/operations/DeleteStation\"\u003ePOST\u003c/a\u003e\r\n          \u003c/td\u003e\r\n          \u003ctd\u003eDelete a stationExample: http://localhost/ServicewTM.svc/Admin/DeleteStation/FastApp/3\u003c/td\u003e\r\n        \u003c/tr\u003e\r\n        \u003ctr\u003e\r\n          \u003ctd\u003e/Admin/DeleteTask/{application}/{jobIndex}/{taskIndex}\u003c/td\u003e\r\n          \u003ctd title=\"http://localhost:82/service/Admin/DeleteTask/{APPLICATION}/{JOBINDEX}/{TASKINDEX}\"\u003e\r\n            \u003ca rel=\"operation\" href=\"help/operations/DeleteTask\"\u003ePOST\u003c/a\u003e\r\n          \u003c/td\u003e\r\n          \u003ctd\u003eDelete a task. Example: http://localhost/ServicewTM.svc/Admin/DeleteTask/FastApp/3/2\u003c/td\u003e\r\n        \u003c/tr\u003e\r\n        \u003ctr\u003e\r\n          \u003ctd\u003e/Admin/DeleteUser/{application}/{index}\u003c/td\u003e\r\n          \u003ctd title=\"http://localhost:82/service/Admin/DeleteUser/{APPLICATION}/{INDEX}\"\u003e\r\n            \u003ca rel=\"operation\" href=\"help/operations/DeleteUser\"\u003ePOST\u003c/a\u003e\r\n          \u003c/td\u003e\r\n          \u003ctd\u003eDelete user. Example: http://localhost/ServicewTM.svc/Admin/DeleteUser/FastApp/2\u003c/td\u003e\r\n        \u003c/tr\u003e\r\n        \u003ctr\u003e\r\n          \u003ctd\u003e/Admin/DeleteWorkflow/{application}/{index}\u003c/td\u003e\r\n          \u003ctd title=\"http://localhost:82/service/Admin/DeleteWorkflow/{APPLICATION}/{INDEX}\"\u003e\r\n            \u003ca rel=\"operation\" href=\"help/operations/DeleteWorkflow\"\u003ePOST\u003c/a\u003e\r\n          \u003c/td\u003e\r\n          \u003ctd\u003eDelete workflow. Example: http://localhost/ServicewTM.svc/Admin/DeleteWorkflow/FastApp/2\u003c/td\u003e\r\n        \u003c/tr\u003e\r\n        \u003ctr\u003e\r\n          \u003ctd\u003e/Admin/GetApplicationEnvData/{application}/{version}/{build}\u003c/td\u003e\r\n          \u003ctd title=\"http://localhost:82/service/Admin/GetApplicationEnvData/{APPLICATION}/{VERSION}/{BUILD}\"\u003e\r\n            \u003ca rel=\"operation\" href=\"help/operations/GetApplicationEnvData\"\u003eGET\u003c/a\u003e\r\n          \u003c/td\u003e\r\n          \u003ctd\u003eGet a Datacap application environment data to run rules locally. Example: http://localhost/ServicewTM.svc/Admin/GetApplicationEnvData/FastApp/1/2\u003c/td\u003e\r\n        \u003c/tr\u003e\r\n        \u003ctr\u003e\r\n          \u003ctd\u003e/Admin/GetApplicationList\u003c/td\u003e\r\n          \u003ctd title=\"http://localhost:82/service/Admin/GetApplicationList\"\u003e\r\n            \u003ca rel=\"operation\" href=\"help/operations/GetApplicationList\"\u003eGET\u003c/a\u003e\r\n          \u003c/td\u003e\r\n          \u003ctd\u003eReturns a list of Taskmaster applications defined in Taskmaster Application Manager.\u003c/td\u003e\r\n        \u003c/tr\u003e\r\n        \u003ctr\u003e\r\n          \u003ctd\u003e/Admin/GetCondition/{application}/{workflowIndex}/{jobIndex}/{taskIndex}\u003c/td\u003e\r\n          \u003ctd title=\"http://localhost:82/service/Admin/GetCondition/{APPLICATION}/{WORKFLOWINDEX}/{JOBINDEX}/{TASKINDEX}\"\u003e\r\n            \u003ca rel=\"operation\" href=\"help/operations/GetCondition\"\u003eGET\u003c/a\u003e\r\n          \u003c/td\u003e\r\n          \u003ctd\u003eGet the condition of a task. Example: http://localhost/ServicewTM.svc/Admin/GetCondition/FastApp/3/2/1\u003c/td\u003e\r\n        \u003c/tr\u003e\r\n        \u003ctr\u003e\r\n          \u003ctd\u003e/Admin/GetConfiguration/{application}/{name}/{extension}\u003c/td\u003e\r\n          \u003ctd title=\"http://localhost:82/service/Admin/GetConfiguration/{APPLICATION}/{NAME}/{EXTENSION}\"\u003e\r\n            \u003ca rel=\"operation\" href=\"help/operations/GetConfiguration\"\u003eGET\u003c/a\u003e\r\n          \u003c/td\u003e\r\n          \u003ctd\u003eGet a Datacap configuration.Example: http://localhost/ServicewTM.svc/Admin/GetConfiguration/FastApp/UserSetting/json\u003c/td\u003e\r\n        \u003c/tr\u003e\r\n        \u003ctr\u003e\r\n          \u003ctd\u003e/Admin/GetCustomTranslatedAppData/{application}/{dcoID}/{lang}\u003c/td\u003e\r\n          \u003ctd title=\"http://localhost:82/service/Admin/GetCustomTranslatedAppData/{APPLICATION}/{DCOID}/{LANG}\"\u003e\r\n            \u003ca rel=\"operation\" href=\"help/operations/GetCustomTranslatedAppData\"\u003eGET\u003c/a\u003e\r\n          \u003c/td\u003e\r\n          \u003ctd\u003eGet a Datacap custom translated application data. Example: http://localhost/ServicewTM.svc/Admin/GetCustomTranslatedAppData/FastApp/FastApp/zh\u003c/td\u003e\r\n        \u003c/tr\u003e\r\n        \u003ctr\u003e\r\n          \u003ctd\u003e/Admin/GetFingerprintFile/{application}/{fileName}/{fileExtension}\u003c/td\u003e\r\n          \u003ctd title=\"http://localhost:82/service/Admin/GetFingerprintFile/{APPLICATION}/{FILENAME}/{FILEEXTENSION}\"\u003e\r\n            \u003ca rel=\"operation\" href=\"help/operations/GetFingerprintFile\"\u003eGET\u003c/a\u003e\r\n          \u003c/td\u003e\r\n          \u003ctd\u003eReturns the requested fingerprint position file in xml format or fingerprint image file in jpg format using the application.\u003c/td\u003e\r\n        \u003c/tr\u003e\r\n        \u003ctr\u003e\r\n          \u003ctd\u003e/Admin/GetFingerprintList/{application}/{pageType}/{dcoID}\u003c/td\u003e\r\n          \u003ctd title=\"http://localhost:82/service/Admin/GetFingerprintList/{APPLICATION}/{PAGETYPE}/{DCOID}\"\u003e\r\n            \u003ca rel=\"operation\" href=\"help/operations/GetFingerprintList\"\u003eGET\u003c/a\u003e\r\n          \u003c/td\u003e\r\n          \u003ctd\u003eReturns the requested fingerprint list using the application, page type, and dco id. \u003c/td\u003e\r\n        \u003c/tr\u003e\r\n        \u003ctr\u003e\r\n          \u003ctd\u003e/Admin/GetGroupList/{application}\u003c/td\u003e\r\n          \u003ctd title=\"http://localhost:82/service/Admin/GetGroupList/{APPLICATION}\"\u003e\r\n            \u003ca rel=\"operation\" href=\"help/operations/GetGroupList\"\u003eGET\u003c/a\u003e\r\n          \u003c/td\u003e\r\n          \u003ctd\u003eReturns groups list. Example: http://localhost/ServicewTM.svc/Admin/GetGroupList/FastApp/1\u003c/td\u003e\r\n        \u003c/tr\u003e\r\n        \u003ctr\u003e\r\n          \u003ctd\u003e/Admin/GetGroupPermissionList/{application}/{groupInd}\u003c/td\u003e\r\n          \u003ctd title=\"http://localhost:82/service/Admin/GetGroupPermissionList/{APPLICATION}/{GROUPIND}\"\u003e\r\n            \u003ca rel=\"operation\" href=\"help/operations/GetGroupPermissionList\"\u003eGET\u003c/a\u003e\r\n          \u003c/td\u003e\r\n          \u003ctd\u003eReturns a job index/task index pair list the group has permission for.Example: http://localhost/ServicewTM.svc/Admin/GetGroupPermissionList/FastApp/0\u003c/td\u003e\r\n        \u003c/tr\u003e\r\n        \u003ctr\u003e\r\n          \u003ctd\u003e/Admin/GetJobList/{application}/{workflowIndex}\u003c/td\u003e\r\n          \u003ctd title=\"http://localhost:82/service/Admin/GetJobList/{APPLICATION}/{WORKFLOWINDEX}\"\u003e\r\n            \u003ca rel=\"operation\" href=\"help/operations/GetJobList\"\u003eGET\u003c/a\u003e\r\n          \u003c/td\u003e\r\n          \u003ctd\u003eReturns a list of jobs using the application name and workflow index.Example: http://localhost/ServicewTM.svc/Admin/GetJobList/FastApp/2\u003c/td\u003e\r\n        \u003c/tr\u003e\r\n        \u003ctr\u003e\r\n          \u003ctd\u003e/Admin/GetMobileProfiles/{application}/\u003c/td\u003e\r\n          \u003ctd title=\"http://localhost:82/service/Admin/GetMobileProfiles/{APPLICATION}/\"\u003e\r\n            \u003ca rel=\"operation\" href=\"help/operations/GetMobileProfiles\"\u003eGET\u003c/a\u003e\r\n          \u003c/td\u003e\r\n          \u003ctd\u003eGet a list of mobile profiles the logged on user has permission to for using the application name.Example: http://localhost/ServicewTM.svc/Admin/GetMoibleProfiles/FastApp\u003c/td\u003e\r\n        \u003c/tr\u003e\r\n        \u003ctr\u003e\r\n          \u003ctd\u003e/Admin/GetNavigatorPanel/{application}/{name}\u003c/td\u003e\r\n          \u003ctd title=\"http://localhost:82/service/Admin/GetNavigatorPanel/{APPLICATION}/{NAME}\"\u003e\r\n            \u003ca rel=\"operation\" href=\"help/operations/GetNavigatorPanel\"\u003eGET\u003c/a\u003e\r\n          \u003c/td\u003e\r\n          \u003ctd\u003eGet a Datacap Navigator panel.Example: http://localhost/ServicewTM.svc/Admin/GetNavigatorPanel/FastApp/panel1\u003c/td\u003e\r\n        \u003c/tr\u003e\r\n        \u003ctr\u003e\r\n          \u003ctd\u003e/Admin/GetNavigatorPanelList/{application}\u003c/td\u003e\r\n          \u003ctd title=\"http://localhost:82/service/Admin/GetNavigatorPanelList/{APPLICATION}\"\u003e\r\n            \u003ca rel=\"operation\" href=\"help/operations/GetNavigatorPanelList\"\u003eGET\u003c/a\u003e\r\n          \u003c/td\u003e\r\n          \u003ctd\u003eGet all Datacap Navigator panels.Example: http://localhost/ServicewTM.svc/Admin/GetNavigatorPanelList/FastApp\u003c/td\u003e\r\n        \u003c/tr\u003e\r\n        \u003ctr\u003e\r\n          \u003ctd\u003e/Admin/GetPrivilegeList/{application}/{objectType}/{objectIndex}\u003c/td\u003e\r\n          \u003ctd title=\"http://localhost:82/service/Admin/GetPrivilegeList/{APPLICATION}/{OBJECTTYPE}/{OBJECTINDEX}\"\u003e\r\n            \u003ca rel=\"operation\" href=\"help/operations/GetPrivilegeList\"\u003eGET\u003c/a\u003e\r\n          \u003c/td\u003e\r\n          \u003ctd\u003eReturns a list of privileges the user or group have permission for.  objectType = 7 for a user and objectType = 6 for a group.Example: http://localhost/ServicewTM.svc/Admin/GetPrivilegeList/FastApp/7/0\u003c/td\u003e\r\n        \u003c/tr\u003e\r\n        \u003ctr\u003e\r\n          \u003ctd\u003e/Admin/GetProgramFile/{application}/{fileName}/{fileExtension}\u003c/td\u003e\r\n          \u003ctd title=\"http://localhost:82/service/Admin/GetProgramFile/{APPLICATION}/{FILENAME}/{FILEEXTENSION}\"\u003e\r\n            \u003ca rel=\"operation\" href=\"help/operations/GetProgramFile\"\u003eGET\u003c/a\u003e\r\n          \u003c/td\u003e\r\n          \u003ctd\u003eReturns the requested file using the application, file name without path and extension \u0027set.xml\u0027 such as fileName=Rulerunner and fileExtension=exe for Rulerunner.exe.set.xmlUser must have administrator workflow permission.\u003c/td\u003e\r\n        \u003c/tr\u003e\r\n        \u003ctr\u003e\r\n          \u003ctd\u003e/Admin/GetSetupDCOFile/{application}/{dcoName}\u003c/td\u003e\r\n          \u003ctd title=\"http://localhost:82/service/Admin/GetSetupDCOFile/{APPLICATION}/{DCONAME}\"\u003e\r\n            \u003ca rel=\"operation\" href=\"help/operations/GetSetupDCOFile\"\u003eGET\u003c/a\u003e\r\n          \u003c/td\u003e\r\n          \u003ctd\u003eGet the setup DCO definition using the application and setup DCO name.Example: http://localhost/ServicewTM.svc/Admin/GetSetupDCOFile/FastApp/FastApp\u003c/td\u003e\r\n        \u003c/tr\u003e\r\n        \u003ctr\u003e\r\n          \u003ctd\u003e/Admin/GetSetupDCOList/{application}\u003c/td\u003e\r\n          \u003ctd title=\"http://localhost:82/service/Admin/GetSetupDCOList/{APPLICATION}\"\u003e\r\n            \u003ca rel=\"operation\" href=\"help/operations/GetSetupDCOList\"\u003eGET\u003c/a\u003e\r\n          \u003c/td\u003e\r\n          \u003ctd\u003eGet the setup DCO list. Example: http://localhost/ServicewTM.svc/Admin/GetSetupDCOList/FastApp.\u003c/td\u003e\r\n        \u003c/tr\u003e\r\n        \u003ctr\u003e\r\n          \u003ctd\u003e/Admin/GetShortcutList/{application}\u003c/td\u003e\r\n          \u003ctd title=\"http://localhost:82/service/Admin/GetShortcutList/{APPLICATION}\"\u003e\r\n            \u003ca rel=\"operation\" href=\"help/operations/GetShortcutList\"\u003eGET\u003c/a\u003e\r\n          \u003c/td\u003e\r\n          \u003ctd\u003eReturns shortcut list using the application name.Example: http://localhost/ServicewTM.svc/Admin/GetShortcutList/FastApp\u003c/td\u003e\r\n        \u003c/tr\u003e\r\n        \u003ctr\u003e\r\n          \u003ctd\u003e/Admin/GetShortcutPermissionList/{application}/{shortcutInd}\u003c/td\u003e\r\n          \u003ctd title=\"http://localhost:82/service/Admin/GetShortcutPermissionList/{APPLICATION}/{SHORTCUTIND}\"\u003e\r\n            \u003ca rel=\"operation\" href=\"help/operations/GetShortcutPermissionList\"\u003eGET\u003c/a\u003e\r\n          \u003c/td\u003e\r\n          \u003ctd\u003eReturns a job index/task index pair list the shortcut has permission for.Example: http://localhost/ServicewTM.svc/Admin/GetShortcutPermissionList/FastApp/0\u003c/td\u003e\r\n        \u003c/tr\u003e\r\n        \u003ctr\u003e\r\n          \u003ctd\u003e/Admin/GetStationList/{application}\u003c/td\u003e\r\n          \u003ctd title=\"http://localhost:82/service/Admin/GetStationList/{APPLICATION}\"\u003e\r\n            \u003ca rel=\"operation\" href=\"help/operations/GetStationList\"\u003eGET\u003c/a\u003e\r\n          \u003c/td\u003e\r\n          \u003ctd\u003eReturns station list using the application nameExample: http://localhost/ServicewTM.svc/Admin/GetStationList/FastApp?bRetrievePermissions=true\u003c/td\u003e\r\n        \u003c/tr\u003e\r\n        \u003ctr\u003e\r\n          \u003ctd\u003e/Admin/GetStationPermissionList/{application}/{stationInd}\u003c/td\u003e\r\n          \u003ctd title=\"http://localhost:82/service/Admin/GetStationPermissionList/{APPLICATION}/{STATIONIND}\"\u003e\r\n            \u003ca rel=\"operation\" href=\"help/operations/GetStationPermissionList\"\u003eGET\u003c/a\u003e\r\n          \u003c/td\u003e\r\n          \u003ctd\u003eReturns a job index/task index pair list the station has permission for.Example: http://localhost/ServicewTM.svc/Admin/GetStationPermissionList/FastApp/0\u003c/td\u003e\r\n        \u003c/tr\u003e\r\n        \u003ctr\u003e\r\n          \u003ctd\u003e/Admin/GetTaskList/{application}/{jobIndex}\u003c/td\u003e\r\n          \u003ctd title=\"http://localhost:82/service/Admin/GetTaskList/{APPLICATION}/{JOBINDEX}\"\u003e\r\n            \u003ca rel=\"operation\" href=\"help/operations/GetTaskList\"\u003eGET\u003c/a\u003e\r\n          \u003c/td\u003e\r\n          \u003ctd\u003eReturns a list of tasks using the application name and job index.Example: http://localhost/ServicewTM.svc/Admin/GetTaskList/FastApp/2. Set jobIndex to -3 if need to return all tasks under application. In returned attributes, id is the task name, desc is the task description, index is the task index, mode is the task mode (2-normal, 3-batch creation, 6-router),  queueBy is how to queue jobs of this task(0-none, 1-station, 2-user, 3-otherStation, 4-otherUser, 5-stationUser, 6-stationOtherUser, 7-userOtherStation, 8-otherStationOtherUser ), store is what to store for this task, which will be used in queuing (0-none, 1-station, 2-user, 3-station and user), program is the task program, conditions is the task condition name.\u003c/td\u003e\r\n        \u003c/tr\u003e\r\n        \u003ctr\u003e\r\n          \u003ctd\u003e/Admin/GetTaskProfileList/{application}\u003c/td\u003e\r\n          \u003ctd title=\"http://localhost:82/service/Admin/GetTaskProfileList/{APPLICATION}\"\u003e\r\n            \u003ca rel=\"operation\" href=\"help/operations/GetTaskProfileList\"\u003eGET\u003c/a\u003e\r\n          \u003c/td\u003e\r\n          \u003ctd\u003eReturns a list of task profiles defined in the specified application.Example: http://localhost/ServicewTM.svc/Admin/GetTaskProfileList/FastApp\u003c/td\u003e\r\n        \u003c/tr\u003e\r\n        \u003ctr\u003e\r\n          \u003ctd\u003e/Admin/GetTaskSettingsFile/{application}/{jobID}/{taskID}\u003c/td\u003e\r\n          \u003ctd title=\"http://localhost:82/service/Admin/GetTaskSettingsFile/{APPLICATION}/{JOBID}/{TASKID}\"\u003e\r\n            \u003ca rel=\"operation\" href=\"help/operations/GetTaskSettingsFile\"\u003eGET\u003c/a\u003e\r\n          \u003c/td\u003e\r\n          \u003ctd\u003eReturns the requested file using the application, job ID and task ID such as taskID=Verify for Verify.set.xml. \u003c/td\u003e\r\n        \u003c/tr\u003e\r\n        \u003ctr\u003e\r\n          \u003ctd\u003e/Admin/GetTaskSettingsFileByName/{application}/{jobName}/{taskName}\u003c/td\u003e\r\n          \u003ctd title=\"http://localhost:82/service/Admin/GetTaskSettingsFileByName/{APPLICATION}/{JOBNAME}/{TASKNAME}\"\u003e\r\n            \u003ca rel=\"operation\" href=\"help/operations/GetTaskSettingsFileByName\"\u003eGET\u003c/a\u003e\r\n          \u003c/td\u003e\r\n          \u003ctd\u003eReturns the requested file using the application, job name and task name, such as taskID=Verify for Verify.set.xml. \u003c/td\u003e\r\n        \u003c/tr\u003e\r\n        \u003ctr\u003e\r\n          \u003ctd\u003e/Admin/GetUserList/{application}\u003c/td\u003e\r\n          \u003ctd title=\"http://localhost:82/service/Admin/GetUserList/{APPLICATION}\"\u003e\r\n            \u003ca rel=\"operation\" href=\"help/operations/GetUserList\"\u003eGET\u003c/a\u003e\r\n          \u003c/td\u003e\r\n          \u003ctd\u003eReturns users list.Example: http://localhost/ServicewTM.svc/Admin/GetUserList/FastApp\u003c/td\u003e\r\n        \u003c/tr\u003e\r\n        \u003ctr\u003e\r\n          \u003ctd\u003e/Admin/GetUserPermissionList/{application}/{userInd}\u003c/td\u003e\r\n          \u003ctd title=\"http://localhost:82/service/Admin/GetUserPermissionList/{APPLICATION}/{USERIND}\"\u003e\r\n            \u003ca rel=\"operation\" href=\"help/operations/GetUserPermissionList\"\u003eGET\u003c/a\u003e\r\n          \u003c/td\u003e\r\n          \u003ctd\u003eReturns a job index/task index pair list the user has permission for.Example: http://localhost/ServicewTM.svc/Admin/GetUserPermissionList/FastApp/0\u003c/td\u003e\r\n        \u003c/tr\u003e\r\n        \u003ctr\u003e\r\n          \u003ctd\u003e/Admin/GetWorkflowHierarchy/{application}\u003c/td\u003e\r\n          \u003ctd title=\"http://localhost:82/service/Admin/GetWorkflowHierarchy/{APPLICATION}\"\u003e\r\n            \u003ca rel=\"operation\" href=\"help/operations/GetWorkflowHierarchy\"\u003eGET\u003c/a\u003e\r\n          \u003c/td\u003e\r\n          \u003ctd\u003eReturns the workflow hierarchy using the application name.Example: http://localhost/ServicewTM.svc/Admin/GetWorkflowHierarchy/FastApp\u003c/td\u003e\r\n        \u003c/tr\u003e\r\n        \u003ctr\u003e\r\n          \u003ctd\u003e/Admin/GetWorkFlowList/{application}\u003c/td\u003e\r\n          \u003ctd title=\"http://localhost:82/service/Admin/GetWorkFlowList/{APPLICATION}\"\u003e\r\n            \u003ca rel=\"operation\" href=\"help/operations/GetWorkFlowList\"\u003eGET\u003c/a\u003e\r\n          \u003c/td\u003e\r\n          \u003ctd\u003eReturns a list of workflows using the application name.Example: http://localhost/ServicewTM.svc/Admin/GetWorkFlowList/FastApp\u003c/td\u003e\r\n        \u003c/tr\u003e\r\n        \u003ctr\u003e\r\n          \u003ctd\u003e/Admin/MoveDownTask/{application}/{JobIndex}/{taskIndex}\u003c/td\u003e\r\n          \u003ctd title=\"http://localhost:82/service/Admin/MoveDownTask/{APPLICATION}/{JOBINDEX}/{TASKINDEX}\"\u003e\r\n            \u003ca rel=\"operation\" href=\"help/operations/MoveDownTask\"\u003eGET\u003c/a\u003e\r\n          \u003c/td\u003e\r\n          \u003ctd\u003eMove Down Task. Example: http://localhost/ServicewTM.svc/Admin/MoveDownTask/FastApp/3/2\u003c/td\u003e\r\n        \u003c/tr\u003e\r\n        \u003ctr\u003e\r\n          \u003ctd\u003e/Admin/MoveUpTask/{application}/{JobIndex}/{taskIndex}\u003c/td\u003e\r\n          \u003ctd title=\"http://localhost:82/service/Admin/MoveUpTask/{APPLICATION}/{JOBINDEX}/{TASKINDEX}\"\u003e\r\n            \u003ca rel=\"operation\" href=\"help/operations/MoveUpTask\"\u003eGET\u003c/a\u003e\r\n          \u003c/td\u003e\r\n          \u003ctd\u003eMove Up Task. Example: http://localhost/ServicewTM.svc/Admin/MoveUpTask/FastApp/3/2\u003c/td\u003e\r\n        \u003c/tr\u003e\r\n        \u003ctr\u003e\r\n          \u003ctd\u003e/Admin/SaveCondition\u003c/td\u003e\r\n          \u003ctd title=\"http://localhost:82/service/Admin/SaveCondition\"\u003e\r\n            \u003ca rel=\"operation\" href=\"help/operations/SaveCondition\"\u003ePOST\u003c/a\u003e\r\n          \u003c/td\u003e\r\n          \u003ctd\u003eSave a condition under workflow/job/task pair. Example: http://localhost/ServicewTM.svc/Admin/SaveCondition\u003c/td\u003e\r\n        \u003c/tr\u003e\r\n        \u003ctr\u003e\r\n          \u003ctd\u003e/Admin/SaveGroup\u003c/td\u003e\r\n          \u003ctd title=\"http://localhost:82/service/Admin/SaveGroup\"\u003e\r\n            \u003ca rel=\"operation\" href=\"help/operations/SaveGroup\"\u003ePOST\u003c/a\u003e\r\n          \u003c/td\u003e\r\n          \u003ctd\u003eSave or create a group. index=-2 means creating a new group.Example: http://localhost/ServicewTM.svc/Admin/SaveGroup\u003c/td\u003e\r\n        \u003c/tr\u003e\r\n        \u003ctr\u003e\r\n          \u003ctd\u003e/Admin/SaveJob\u003c/td\u003e\r\n          \u003ctd title=\"http://localhost:82/service/Admin/SaveJob\"\u003e\r\n            \u003ca rel=\"operation\" href=\"help/operations/SaveJob\"\u003ePOST\u003c/a\u003e\r\n          \u003c/td\u003e\r\n          \u003ctd\u003eSave or create a job. index=-2 means creating a new job.Example: http://localhost/ServicewTM.svc/Admin/SaveJob\u003c/td\u003e\r\n        \u003c/tr\u003e\r\n        \u003ctr\u003e\r\n          \u003ctd\u003e/Admin/SaveNavigatorPanel/{application}/{name}\u003c/td\u003e\r\n          \u003ctd title=\"http://localhost:82/service/Admin/SaveNavigatorPanel/{APPLICATION}/{NAME}\"\u003e\r\n            \u003ca rel=\"operation\" href=\"help/operations/SaveNavigatorPanel\"\u003ePOST\u003c/a\u003e\r\n          \u003c/td\u003e\r\n          \u003ctd\u003eSave a Datacap Navigator panel.Example: http://localhost/ServicewTM.svc/Admin/SaveNavigatorPanel/FastApp\u003c/td\u003e\r\n        \u003c/tr\u003e\r\n        \u003ctr\u003e\r\n          \u003ctd\u003e/Admin/SaveSetupDCOFile/{application}/{dcoID}\u003c/td\u003e\r\n          \u003ctd title=\"http://localhost:82/service/Admin/SaveSetupDCOFile/{APPLICATION}/{DCOID}\"\u003e\r\n            \u003ca rel=\"operation\" href=\"help/operations/SaveSetupDCOFile\"\u003ePOST\u003c/a\u003e\r\n          \u003c/td\u003e\r\n          \u003ctd\u003eSave the setup DCO definition using the application and DCO ID. Example: http://localhost/ServicewTM.svc/Admin/SaveSetupDCOFile/FastApp/FastApp.\u003c/td\u003e\r\n        \u003c/tr\u003e\r\n        \u003ctr\u003e\r\n          \u003ctd\u003e/Admin/SaveShortcut\u003c/td\u003e\r\n          \u003ctd title=\"http://localhost:82/service/Admin/SaveShortcut\"\u003e\r\n            \u003ca rel=\"operation\" href=\"help/operations/SaveShortcut\"\u003ePOST\u003c/a\u003e\r\n          \u003c/td\u003e\r\n          \u003ctd\u003eSave a shortcutExample: http://localhost/ServicewTM.svc/Admin/SaveShortcut\u003c/td\u003e\r\n        \u003c/tr\u003e\r\n        \u003ctr\u003e\r\n          \u003ctd\u003e/Admin/SaveStation\u003c/td\u003e\r\n          \u003ctd title=\"http://localhost:82/service/Admin/SaveStation\"\u003e\r\n            \u003ca rel=\"operation\" href=\"help/operations/SaveStation\"\u003ePOST\u003c/a\u003e\r\n          \u003c/td\u003e\r\n          \u003ctd\u003eSave a stationExample: http://localhost/ServicewTM.svc/Admin/SaveStation\u003c/td\u003e\r\n        \u003c/tr\u003e\r\n        \u003ctr\u003e\r\n          \u003ctd\u003e/Admin/SaveTask\u003c/td\u003e\r\n          \u003ctd title=\"http://localhost:82/service/Admin/SaveTask\"\u003e\r\n            \u003ca rel=\"operation\" href=\"help/operations/SaveTask\"\u003ePOST\u003c/a\u003e\r\n          \u003c/td\u003e\r\n          \u003ctd\u003eSave or create a task.The application is the Taskmaster application name as specified in the Taskmaster Application Manager.  Conditions are a comma separated list of the conditions that can be raised.  The desc is a description of the task.  The id is the task index and should be left blank when creating a new task.  The jobId is the index of the current job and is optional for an existing task, but required for a new task.Mode sets the task as a batch creation, in process, or routing task.2 ?Normal3 -  Batch Creation6 ?RoutingThe name is the task name.  The program is the executable or web page the task will use.  The program should be Rulerunner.exe for background tasks even if they are run by a client.  See the web client for a complete list of available programs. queueBy queues the batch to a specific user/station pair.1 ?Station2 - User3 - Other Station4 - Other User5 - Station And User6 - Station And Other User7 - User And Other Station8 - Other Station And Other Userstore saves the current user and station options for queuing in a following task.1 - Station2 - User3 - Other Station4 - Other User5 - Station And User6 - Station And Other User7 - User And Other Station8 - Other Station And Other User\u003c/td\u003e\r\n        \u003c/tr\u003e\r\n        \u003ctr\u003e\r\n          \u003ctd\u003e/Admin/SaveUser\u003c/td\u003e\r\n          \u003ctd title=\"http://localhost:82/service/Admin/SaveUser\"\u003e\r\n            \u003ca rel=\"operation\" href=\"help/operations/SaveUser\"\u003ePOST\u003c/a\u003e\r\n          \u003c/td\u003e\r\n          \u003ctd\u003eSave or create a user. index=-2 means creating a new user.Example: http://localhost/ServicewTM.svc/Admin/SaveUser\u003c/td\u003e\r\n        \u003c/tr\u003e\r\n        \u003ctr\u003e\r\n          \u003ctd\u003e/Admin/SaveWorkflow\u003c/td\u003e\r\n          \u003ctd title=\"http://localhost:82/service/Admin/SaveWorkflow\"\u003e\r\n            \u003ca rel=\"operation\" href=\"help/operations/SaveWorkflow\"\u003ePOST\u003c/a\u003e\r\n          \u003c/td\u003e\r\n          \u003ctd\u003eSave or create a workflow. index=-2 means creating a new workflow.Example: http://localhost/ServicewTM.svc/Admin/SaveWorkflow\u003c/td\u003e\r\n        \u003c/tr\u003e\r\n        \u003ctr\u003e\r\n          \u003ctd\u003e/Admin/SetConfiguration/{application}/{name}/{extension}\u003c/td\u003e\r\n          \u003ctd title=\"http://localhost:82/service/Admin/SetConfiguration/{APPLICATION}/{NAME}/{EXTENSION}\"\u003e\r\n            \u003ca rel=\"operation\" href=\"help/operations/SetConfiguration\"\u003ePOST\u003c/a\u003e\r\n          \u003c/td\u003e\r\n          \u003ctd\u003eSet a Datacap configuration.Example: http://localhost/ServicewTM.svc/Admin/SetConfiguration/FastApp/UserSetting/json\u003c/td\u003e\r\n        \u003c/tr\u003e\r\n        \u003ctr\u003e\r\n          \u003ctd\u003e/Admin/SetGroupPermissionList/{application}/{groupInd}\u003c/td\u003e\r\n          \u003ctd title=\"http://localhost:82/service/Admin/SetGroupPermissionList/{APPLICATION}/{GROUPIND}\"\u003e\r\n            \u003ca rel=\"operation\" href=\"help/operations/SetGroupPermissionList\"\u003ePOST\u003c/a\u003e\r\n          \u003c/td\u003e\r\n          \u003ctd\u003eSave the job index/task index pair list the group has permission for.\u003c/td\u003e\r\n        \u003c/tr\u003e\r\n        \u003ctr\u003e\r\n          \u003ctd\u003e/Admin/SetPrivilegeList/{application}/{objectType}/{objectIndex}\u003c/td\u003e\r\n          \u003ctd title=\"http://localhost:82/service/Admin/SetPrivilegeList/{APPLICATION}/{OBJECTTYPE}/{OBJECTINDEX}\"\u003e\r\n            \u003ca rel=\"operation\" href=\"help/operations/SetPrivilegeList\"\u003ePOST\u003c/a\u003e\r\n          \u003c/td\u003e\r\n          \u003ctd\u003eSave a list of privileges the user or group have permission for.  objectType = 7 for a user and objectType = 6 for a group.Example: http://localhost/ServicewTM.svc/Admin/SetPrivilegeList/FastApp/7/0\u003c/td\u003e\r\n        \u003c/tr\u003e\r\n        \u003ctr\u003e\r\n          \u003ctd\u003e/Admin/SetShortcutPermissionList/{application}/{shortcutInd}\u003c/td\u003e\r\n          \u003ctd title=\"http://localhost:82/service/Admin/SetShortcutPermissionList/{APPLICATION}/{SHORTCUTIND}\"\u003e\r\n            \u003ca rel=\"operation\" href=\"help/operations/SetShortcutPermissionList\"\u003ePOST\u003c/a\u003e\r\n          \u003c/td\u003e\r\n          \u003ctd\u003eSave the job index/task index pair list the shortcut has permission for.\u003c/td\u003e\r\n        \u003c/tr\u003e\r\n        \u003ctr\u003e\r\n          \u003ctd\u003e/Admin/SetStationPermissionList/{application}/{stationInd}\u003c/td\u003e\r\n          \u003ctd title=\"http://localhost:82/service/Admin/SetStationPermissionList/{APPLICATION}/{STATIONIND}\"\u003e\r\n            \u003ca rel=\"operation\" href=\"help/operations/SetStationPermissionList\"\u003ePOST\u003c/a\u003e\r\n          \u003c/td\u003e\r\n          \u003ctd\u003eSave the job index/task index pair list the station has permission for.\u003c/td\u003e\r\n        \u003c/tr\u003e\r\n        \u003ctr\u003e\r\n          \u003ctd\u003e/Admin/SetTaskSettingsFile/{application}/{jobID}/{taskID}\u003c/td\u003e\r\n          \u003ctd title=\"http://localhost:82/service/Admin/SetTaskSettingsFile/{APPLICATION}/{JOBID}/{TASKID}\"\u003e\r\n            \u003ca rel=\"operation\" href=\"help/operations/SetTaskSettingsFile\"\u003ePOST\u003c/a\u003e\r\n          \u003c/td\u003e\r\n          \u003ctd\u003eUpload the task settings file to server using the application, jobID, file name. \u003c/td\u003e\r\n        \u003c/tr\u003e\r\n        \u003ctr\u003e\r\n          \u003ctd\u003e/Admin/SetUserPermissionList/{application}/{userInd}\u003c/td\u003e\r\n          \u003ctd title=\"http://localhost:82/service/Admin/SetUserPermissionList/{APPLICATION}/{USERIND}\"\u003e\r\n            \u003ca rel=\"operation\" href=\"help/operations/SetUserPermissionList\"\u003ePOST\u003c/a\u003e\r\n          \u003c/td\u003e\r\n          \u003ctd\u003eSave the job index/task index pair list the user has permission for.\u003c/td\u003e\r\n        \u003c/tr\u003e\r\n        \u003ctr\u003e\r\n          \u003ctd\u003e/Queue/AbandonBatch/{application}\u003c/td\u003e\r\n          \u003ctd title=\"http://localhost:82/service/Queue/AbandonBatch/{APPLICATION}\"\u003e\r\n            \u003ca rel=\"operation\" href=\"help/operations/AbandonBatch\"\u003ePOST\u003c/a\u003e\r\n          \u003c/td\u003e\r\n          \u003ctd\u003eAbandon batch records with the batch id. \u003c/td\u003e\r\n        \u003c/tr\u003e\r\n        \u003ctr\u003e\r\n          \u003ctd\u003e/Queue/CheckIntegrity/{application}/{queueId}\u003c/td\u003e\r\n          \u003ctd title=\"http://localhost:82/service/Queue/CheckIntegrity/{APPLICATION}/{QUEUEID}\"\u003e\r\n            \u003ca rel=\"operation\" href=\"help/operations/CheckIntegrity\"\u003eGET\u003c/a\u003e\r\n          \u003c/td\u003e\r\n          \u003ctd\u003eCheck integrity for a batch. Before doing this, the page file needs to be uploaded to server firstly.Example: http://localhost/ServicewTM.svc/Queue/CheckIntegrity/FastApp/30\u003c/td\u003e\r\n        \u003c/tr\u003e\r\n        \u003ctr\u003e\r\n          \u003ctd\u003e/Queue/ClearCacheFolder/{application}/{queueId}\u003c/td\u003e\r\n          \u003ctd title=\"http://localhost:82/service/Queue/ClearCacheFolder/{APPLICATION}/{QUEUEID}\"\u003e\r\n            \u003ca rel=\"operation\" href=\"help/operations/ClearCacheFolder\"\u003ePUT\u003c/a\u003e\r\n          \u003c/td\u003e\r\n          \u003ctd\u003eUpload and clear the cache folder for the batch. This is to avoid the cache folder is copied back when sesion timeout. \u003c/td\u003e\r\n        \u003c/tr\u003e\r\n        \u003ctr\u003e\r\n          \u003ctd\u003e/Queue/CopyFiles\u003c/td\u003e\r\n          \u003ctd title=\"http://localhost:82/service/Queue/CopyFiles\"\u003e\r\n            \u003ca rel=\"operation\" href=\"help/operations/CopyFiles\"\u003ePOST\u003c/a\u003e\r\n          \u003c/td\u003e\r\n          \u003ctd\u003eCopy to create some files for an existing batch.Example: http://localhost/ServicewTM.svc/Queue/CopyFiles\u003c/td\u003e\r\n        \u003c/tr\u003e\r\n        \u003ctr\u003e\r\n          \u003ctd\u003e/Queue/CopyFilesToCache/{application}/{queueId}\u003c/td\u003e\r\n          \u003ctd title=\"http://localhost:82/service/Queue/CopyFilesToCache/{APPLICATION}/{QUEUEID}\"\u003e\r\n            \u003ca rel=\"operation\" href=\"help/operations/CopyFilesToCache\"\u003ePOST\u003c/a\u003e\r\n          \u003c/td\u003e\r\n          \u003ctd\u003eCopy files from the batch folder to the cache folder without downloading to the client.  Must include the wTmId header value returned by Session/Logon.  When files are uploaded or downloaded they are automatically placed in the cache.  This is used primarily to run rules on files such as data files (tm000001.xml, tm00000.cco) for pages that have not been downloaded.\u003c/td\u003e\r\n        \u003c/tr\u003e\r\n        \u003ctr\u003e\r\n          \u003ctd\u003e/Queue/CreateBatch\u003c/td\u003e\r\n          \u003ctd title=\"http://localhost:82/service/Queue/CreateBatch\"\u003e\r\n            \u003ca rel=\"operation\" href=\"help/operations/CreateBatch\"\u003ePOST\u003c/a\u003e\r\n          \u003c/td\u003e\r\n          \u003ctd\u003eCreates a new batch record and get back the batch queue ID. batchFolder and pageFile nodes optional.  Remove the page file node if not used.  To use an existing page file on disk use \u0026lt;file\u0026gt;\\\\pathtofile\\file.xml\u0026lt;/file\u0026gt; and you must specify an existing batch folder.  An XML node may be provided for the pageFile instead replacing the \u0026lt;file /\u0026gt; node.\u003c/td\u003e\r\n        \u003c/tr\u003e\r\n        \u003ctr\u003e\r\n          \u003ctd\u003e/Queue/DeleteBatches/{application}\u003c/td\u003e\r\n          \u003ctd title=\"http://localhost:82/service/Queue/DeleteBatches/{APPLICATION}\"\u003e\r\n            \u003ca rel=\"operation\" href=\"help/operations/DeleteBatches\"\u003ePOST\u003c/a\u003e\r\n          \u003c/td\u003e\r\n          \u003ctd\u003eDelete batch records with the batch directory together. \u003c/td\u003e\r\n        \u003c/tr\u003e\r\n        \u003ctr\u003e\r\n          \u003ctd\u003e/Queue/DeleteSavedFilter/{application}/{userId}/{filterName}\u003c/td\u003e\r\n          \u003ctd title=\"http://localhost:82/service/Queue/DeleteSavedFilter/{APPLICATION}/{USERID}/{FILTERNAME}\"\u003e\r\n            \u003ca rel=\"operation\" href=\"help/operations/DeleteSavedFilter\"\u003ePOST\u003c/a\u003e\r\n          \u003c/td\u003e\r\n          \u003ctd\u003eDelete a saved filter.\u003c/td\u003e\r\n        \u003c/tr\u003e\r\n        \u003ctr\u003e\r\n          \u003ctd\u003e/Queue/ExtractPageFromImage/{application}/{queueId}/{srcFileName}/{destFileName}/{fileExtension}/{pageId}\u003c/td\u003e\r\n          \u003ctd title=\"http://localhost:82/service/Queue/ExtractPageFromImage/{APPLICATION}/{QUEUEID}/{SRCFILENAME}/{DESTFILENAME}/{FILEEXTENSION}/{PAGEID}\"\u003e\r\n            \u003ca rel=\"operation\" href=\"help/operations/ExtractPageFromImage\"\u003ePOST\u003c/a\u003e\r\n          \u003c/td\u003e\r\n          \u003ctd\u003eExtract specific page from multip-pages image file in tiff format using the application, batch queue ID, and file name without path and extension. This endpoint will only accept tif file extension and convert the tif file into same file format.\u003c/td\u003e\r\n        \u003c/tr\u003e\r\n        \u003ctr\u003e\r\n          \u003ctd\u003e/Queue/GetBatchAttributes/{application}/{queueId}\u003c/td\u003e\r\n          \u003ctd title=\"http://localhost:82/service/Queue/GetBatchAttributes/{APPLICATION}/{QUEUEID}\"\u003e\r\n            \u003ca rel=\"operation\" href=\"help/operations/GetBatchAttributes\"\u003eGET\u003c/a\u003e\r\n          \u003c/td\u003e\r\n          \u003ctd\u003eReturns the batch attributes such as the batch ID and status using the application and batch queue ID.\u003c/td\u003e\r\n        \u003c/tr\u003e\r\n        \u003ctr\u003e\r\n          \u003ctd\u003e/Queue/GetBatchHistory/{application}/{queueId}\u003c/td\u003e\r\n          \u003ctd title=\"http://localhost:82/service/Queue/GetBatchHistory/{APPLICATION}/{QUEUEID}\"\u003e\r\n            \u003ca rel=\"operation\" href=\"help/operations/GetBatchHistory\"\u003eGET\u003c/a\u003e\r\n          \u003c/td\u003e\r\n          \u003ctd\u003eReturns batches history details using the application name, batch queue ID.Example: http://localhost/ServicewTM.svc/Queue/GetBatchHistory/FastApp/30\u003c/td\u003e\r\n        \u003c/tr\u003e\r\n        \u003ctr\u003e\r\n          \u003ctd\u003e/Queue/GetBatchId/{application}/{queueId}\u003c/td\u003e\r\n          \u003ctd title=\"http://localhost:82/service/Queue/GetBatchId/{APPLICATION}/{QUEUEID}\"\u003e\r\n            \u003ca rel=\"operation\" href=\"help/operations/GetBatchId\"\u003eGET\u003c/a\u003e\r\n          \u003c/td\u003e\r\n          \u003ctd\u003eReturns the batch ID using the application and batch queue ID.\u003c/td\u003e\r\n        \u003c/tr\u003e\r\n        \u003ctr\u003e\r\n          \u003ctd\u003e/Queue/GetBatchList/{application}/{pageSize}/{pageIndex}/{sort}\u003c/td\u003e\r\n          \u003ctd title=\"http://localhost:82/service/Queue/GetBatchList/{APPLICATION}/{PAGESIZE}/{PAGEINDEX}/{SORT}\"\u003e\r\n            \u003ca rel=\"operation\" href=\"help/operations/GetBatchList\"\u003eGET\u003c/a\u003e\r\n          \u003c/td\u003e\r\n          \u003ctd\u003eReturns a list of batches using the application name, page size, page index, sort column and optional filters.  To add filter use the format databaseField=Operator|Value.Example: http://localhost/ServicewTM.svc/Queue/GetBatchList/FastApp/5/1/qu_id?pb_batch==|20120913.000000\u003c/td\u003e\r\n        \u003c/tr\u003e\r\n        \u003ctr\u003e\r\n          \u003ctd\u003e/Queue/GetCCO/{application}/{queueId}/{imageFileName}\u003c/td\u003e\r\n          \u003ctd title=\"http://localhost:82/service/Queue/GetCCO/{APPLICATION}/{QUEUEID}/{IMAGEFILENAME}\"\u003e\r\n            \u003ca rel=\"operation\" href=\"help/operations/GetCCO\"\u003eGET\u003c/a\u003e\r\n          \u003c/td\u003e\r\n          \u003ctd\u003eReturns the CCO information for an image file, using the application name, batch queue ID and image file name without file externtion.Example: http://localhost/ServicewTM.svc/Queue/GetCCO/FastApp/30/tm000001\u003c/td\u003e\r\n        \u003c/tr\u003e\r\n        \u003ctr\u003e\r\n          \u003ctd\u003e/Queue/GetExtraTMBatchAttributes/{application}\u003c/td\u003e\r\n          \u003ctd title=\"http://localhost:82/service/Queue/GetExtraTMBatchAttributes/{APPLICATION}\"\u003e\r\n            \u003ca rel=\"operation\" href=\"help/operations/GetExtraTMBatchAttributes\"\u003eGET\u003c/a\u003e\r\n          \u003c/td\u003e\r\n          \u003ctd\u003eReturns extra attributes for job monitor by specifying application id. \u003c/td\u003e\r\n        \u003c/tr\u003e\r\n        \u003ctr\u003e\r\n          \u003ctd\u003e/Queue/GetFile/{application}/{queueId}/{fileName}/{fileExtension}\u003c/td\u003e\r\n          \u003ctd title=\"http://localhost:82/service/Queue/GetFile/{APPLICATION}/{QUEUEID}/{FILENAME}/{FILEEXTENSION}\"\u003e\r\n            \u003ca rel=\"operation\" href=\"help/operations/GetFile\"\u003eGET\u003c/a\u003e\r\n          \u003c/td\u003e\r\n          \u003ctd\u003eReturns the requested file using the application, batch queue ID, and file name without path and extension. If the Accept-Encoding is set to gzip, then it will return the file in gzip compression format. \u003c/td\u003e\r\n        \u003c/tr\u003e\r\n        \u003ctr\u003e\r\n          \u003ctd\u003e/Queue/GetJPGImageFile/{application}/{queueId}/{fileName}/{fileExtension}\u003c/td\u003e\r\n          \u003ctd title=\"http://localhost:82/service/Queue/GetJPGImageFile/{APPLICATION}/{QUEUEID}/{FILENAME}/{FILEEXTENSION}\"\u003e\r\n            \u003ca rel=\"operation\" href=\"help/operations/GetJPGImageFile\"\u003eGET\u003c/a\u003e\r\n          \u003c/td\u003e\r\n          \u003ctd\u003eReturns the requested image file in jpg format using the application, batch queue ID, and file name without path and extension. This endpoint will only accept tif file extension and convert the tif file into jpg then return file stream\u003c/td\u003e\r\n        \u003c/tr\u003e\r\n        \u003ctr\u003e\r\n          \u003ctd\u003e/Queue/GetLookupData/{application}/{dcoID}/{dcoFieldName}\u003c/td\u003e\r\n          \u003ctd title=\"http://localhost:82/service/Queue/GetLookupData/{APPLICATION}/{DCOID}/{DCOFIELDNAME}\"\u003e\r\n            \u003ca rel=\"operation\" href=\"help/operations/GetLookupData\"\u003eGET\u003c/a\u003e\r\n          \u003c/td\u003e\r\n          \u003ctd\u003eGet choice list for the lookup DCO property. Example: http://localhost/ServicewTM.svc/Queue/GetLookupData/FastApp/FastApp/Car_Type\u003c/td\u003e\r\n        \u003c/tr\u003e\r\n        \u003ctr\u003e\r\n          \u003ctd\u003e/Queue/GetPageFile/{application}/{queueId}\u003c/td\u003e\r\n          \u003ctd title=\"http://localhost:82/service/Queue/GetPageFile/{APPLICATION}/{QUEUEID}\"\u003e\r\n            \u003ca rel=\"operation\" href=\"help/operations/GetPageFile\"\u003eGET\u003c/a\u003e\r\n          \u003c/td\u003e\r\n          \u003ctd\u003eReturns the XML as string of the current page file using the application and batch queue ID. \u003c/td\u003e\r\n        \u003c/tr\u003e\r\n        \u003ctr\u003e\r\n          \u003ctd\u003e/Queue/GetPageFileName/{application}/{queueId}\u003c/td\u003e\r\n          \u003ctd title=\"http://localhost:82/service/Queue/GetPageFileName/{APPLICATION}/{QUEUEID}\"\u003e\r\n            \u003ca rel=\"operation\" href=\"help/operations/GetPageFileName\"\u003eGET\u003c/a\u003e\r\n          \u003c/td\u003e\r\n          \u003ctd\u003eReturns the current page file XML using the application, batch queue ID. \u003c/td\u003e\r\n        \u003c/tr\u003e\r\n        \u003ctr\u003e\r\n          \u003ctd\u003e/Queue/GetSavedFilter/{application}/{userId}/{filterName}\u003c/td\u003e\r\n          \u003ctd title=\"http://localhost:82/service/Queue/GetSavedFilter/{APPLICATION}/{USERID}/{FILTERNAME}\"\u003e\r\n            \u003ca rel=\"operation\" href=\"help/operations/GetSavedFilter\"\u003eGET\u003c/a\u003e\r\n          \u003c/td\u003e\r\n          \u003ctd\u003eReturn a saved filter.\u003c/td\u003e\r\n        \u003c/tr\u003e\r\n        \u003ctr\u003e\r\n          \u003ctd\u003e/Queue/GetSavedFilterList/{application}/{userId}\u003c/td\u003e\r\n          \u003ctd title=\"http://localhost:82/service/Queue/GetSavedFilterList/{APPLICATION}/{USERID}\"\u003e\r\n            \u003ca rel=\"operation\" href=\"help/operations/GetSavedFilterList\"\u003eGET\u003c/a\u003e\r\n          \u003c/td\u003e\r\n          \u003ctd\u003eReturn the saved filters list.\u003c/td\u003e\r\n        \u003c/tr\u003e\r\n        \u003ctr\u003e\r\n          \u003ctd\u003e/Queue/GrabBatch/{application}/{queueId}\u003c/td\u003e\r\n          \u003ctd title=\"http://localhost:82/service/Queue/GrabBatch/{APPLICATION}/{QUEUEID}\"\u003e\r\n            \u003ca rel=\"operation\" href=\"help/operations/GrabBatch\"\u003ePUT\u003c/a\u003e\r\n          \u003c/td\u003e\r\n          \u003ctd\u003eGrabs batch and sets status to running using the application and batch queue ID.\u003c/td\u003e\r\n        \u003c/tr\u003e\r\n        \u003ctr\u003e\r\n          \u003ctd\u003e/Queue/GrabNextPendingBatchOnJobTaskList/{application}/{JobNameList}/{TaskNameList}\u003c/td\u003e\r\n          \u003ctd title=\"http://localhost:82/service/Queue/GrabNextPendingBatchOnJobTaskList/{APPLICATION}/{JOBNAMELIST}/{TASKNAMELIST}\"\u003e\r\n            \u003ca rel=\"operation\" href=\"help/operations/GrabNextPendingBatchOnJobTaskList\"\u003ePUT\u003c/a\u003e\r\n          \u003c/td\u003e\r\n          \u003ctd\u003eGrabs next pending batch and sets status to running using the application, JobNameList and TaskNameList. JobNameList and TaskNameList are used to define which jobtask to use.\u003c/td\u003e\r\n        \u003c/tr\u003e\r\n        \u003ctr\u003e\r\n          \u003ctd\u003e/Queue/GrabNextPendingBatchOnJobTaskListEx/{application}\u003c/td\u003e\r\n          \u003ctd title=\"http://localhost:82/service/Queue/GrabNextPendingBatchOnJobTaskListEx/{APPLICATION}\"\u003e\r\n            \u003ca rel=\"operation\" href=\"help/operations/GrabNextPendingBatchOnJobTaskListEx\"\u003ePUT\u003c/a\u003e\r\n          \u003c/td\u003e\r\n          \u003ctd\u003eGrabs next pending batch and sets status to running using the application. JobList and TaskList are used to define which jobtask to use.\u003c/td\u003e\r\n        \u003c/tr\u003e\r\n        \u003ctr\u003e\r\n          \u003ctd\u003e/Queue/ReleaseBatch/{application}/{queueId}/{status}\u003c/td\u003e\r\n          \u003ctd title=\"http://localhost:82/service/Queue/ReleaseBatch/{APPLICATION}/{QUEUEID}/{STATUS}\"\u003e\r\n            \u003ca rel=\"operation\" href=\"help/operations/ReleaseBatch\"\u003ePUT\u003c/a\u003e\r\n          \u003c/td\u003e\r\n          \u003ctd\u003eRelease batch using the application and batch queue ID.  Must be called to advance batch to next task. Status should be hold, finished, cancelled, aborted, offline. If the Content-Encoding is set to gzip, then it will accept the file in gzip compression format.\u003c/td\u003e\r\n        \u003c/tr\u003e\r\n        \u003ctr\u003e\r\n          \u003ctd\u003e/Queue/SaveBatchAttribute/{application}\u003c/td\u003e\r\n          \u003ctd title=\"http://localhost:82/service/Queue/SaveBatchAttribute/{APPLICATION}\"\u003e\r\n            \u003ca rel=\"operation\" href=\"help/operations/SaveBatchAttribute\"\u003ePOST\u003c/a\u003e\r\n          \u003c/td\u003e\r\n          \u003ctd\u003eSave batch attribute. If the logon user does not have status change privilege(16), then neither of jobTaskOrder, queueStatus or taskID will be saved.If the logon user does not have Priority/Operator change privilege(64), then neither of QueuePriority, Operator, Station, SkipOperator, or SkipStation will be saved. If the logon user does not have Batch attributes change privilege(128), then neither of BatchDir or PageFile will be saved.Example: http://localhost/ServicewTM.svc/Queue/SaveBatchAttribute/FastApp\u003c/td\u003e\r\n        \u003c/tr\u003e\r\n        \u003ctr\u003e\r\n          \u003ctd\u003e/Queue/SaveSavedFilter/{application}/{userId}/{filterName}\u003c/td\u003e\r\n          \u003ctd title=\"http://localhost:82/service/Queue/SaveSavedFilter/{APPLICATION}/{USERID}/{FILTERNAME}\"\u003e\r\n            \u003ca rel=\"operation\" href=\"help/operations/SaveSavedFilter\"\u003ePOST\u003c/a\u003e\r\n          \u003c/td\u003e\r\n          \u003ctd\u003eSave the saved filter.\u003c/td\u003e\r\n        \u003c/tr\u003e\r\n        \u003ctr\u003e\r\n          \u003ctd\u003e/Queue/SetFile/{application}/{queueId}/{fileName}/{fileExtension}\u003c/td\u003e\r\n          \u003ctd title=\"http://localhost:82/service/Queue/SetFile/{APPLICATION}/{QUEUEID}/{FILENAME}/{FILEEXTENSION}\"\u003e\r\n            \u003ca rel=\"operation\" href=\"help/operations/SetFile\"\u003ePOST\u003c/a\u003e\r\n          \u003c/td\u003e\r\n          \u003ctd\u003eUpload a file to an existing batch using the application, batch queue ID, file name and file extension.  A page object will not be added to the page file.  May be used to update a page file e.g. verify.xml.  Files may be uploaded using the multipart/form-data content type or by streaming the file.  If streaming the content type should be that of the file being uploaded.  Files may be transferred as a binary string or using base64 encoding.  To use base64 encoding add Content-Transfer-Encoding: base64 to the header if streaming or as the last property in the message part before the file if using multipart/form-data.\u003c/td\u003e\r\n        \u003c/tr\u003e\r\n        \u003ctr\u003e\r\n          \u003ctd\u003e/Queue/SetPageFileName/{application}/{queueId}/{fileName}/{fileExtension}\u003c/td\u003e\r\n          \u003ctd title=\"http://localhost:82/service/Queue/SetPageFileName/{APPLICATION}/{QUEUEID}/{FILENAME}/{FILEEXTENSION}\"\u003e\r\n            \u003ca rel=\"operation\" href=\"help/operations/SetPageFileName\"\u003ePUT\u003c/a\u003e\r\n          \u003c/td\u003e\r\n          \u003ctd\u003eSets the name of the page file for the batch e.g. verify.xml.\u003c/td\u003e\r\n        \u003c/tr\u003e\r\n        \u003ctr\u003e\r\n          \u003ctd\u003e/Queue/UploadFile/{application}/{queueId}\u003c/td\u003e\r\n          \u003ctd title=\"http://localhost:82/service/Queue/UploadFile/{APPLICATION}/{QUEUEID}\"\u003e\r\n            \u003ca rel=\"operation\" href=\"help/operations/UploadFile\"\u003ePOST\u003c/a\u003e\r\n          \u003c/td\u003e\r\n          \u003ctd\u003eUpload one or more files as a stream to an existing batch using the application and batch queue ID.  A page object will be added to the page file.  Files may be uploaded using the multipart/form-data content type or by streaming a single file.  If streaming the content type should be that of the file being uploaded.  Files may be transferred as a binary string or using base64 encoding.  To use base64 encoding add Content-Transfer-Encoding: base64 to the header if streaming or as the last property in the message part before the file if using multipart/form-data. If the Content-Encoding is set to gzip, then it will accept the file in gzip compression format.\u003c/td\u003e\r\n        \u003c/tr\u003e\r\n        \u003ctr\u003e\r\n          \u003ctd\u003e/Rules/Execute\u003c/td\u003e\r\n          \u003ctd title=\"http://localhost:82/service/Rules/Execute\"\u003e\r\n            \u003ca rel=\"operation\" href=\"help/operations/Execute\"\u003ePOST\u003c/a\u003e\r\n          \u003c/td\u003e\r\n          \u003ctd\u003eExecute rules on a specified batch.\u003c/td\u003e\r\n        \u003c/tr\u003e\r\n        \u003ctr\u003e\r\n          \u003ctd\u003e/Session/ChangeUserPassword\u003c/td\u003e\r\n          \u003ctd title=\"http://localhost:82/service/Session/ChangeUserPassword\"\u003e\r\n            \u003ca rel=\"operation\" href=\"help/operations/ChangeUserPassword\"\u003ePOST\u003c/a\u003e\r\n          \u003c/td\u003e\r\n          \u003ctd\u003eChange password for a user. Example: http://localhost/ServicewTM.svc/Session/ChangeUserPassword\u003c/td\u003e\r\n        \u003c/tr\u003e\r\n        \u003ctr\u003e\r\n          \u003ctd\u003e/Session/KeepAlive/{application}\u003c/td\u003e\r\n          \u003ctd title=\"http://localhost:82/service/Session/KeepAlive/{APPLICATION}\"\u003e\r\n            \u003ca rel=\"operation\" href=\"help/operations/KeepAlive\"\u003eGET\u003c/a\u003e\r\n          \u003c/td\u003e\r\n          \u003ctd\u003eTo keep the session aliveExample: http://localhost/ServicewTM.svc/Session/KeepAlive/APT\u003c/td\u003e\r\n        \u003c/tr\u003e\r\n        \u003ctr\u003e\r\n          \u003ctd\u003e/Session/Logoff\u003c/td\u003e\r\n          \u003ctd title=\"http://localhost:82/service/Session/Logoff\"\u003e\r\n            \u003ca rel=\"operation\" href=\"help/operations/Logoff\"\u003ePOST\u003c/a\u003e\r\n          \u003c/td\u003e\r\n          \u003ctd\u003eLogs the user out of the Taskmaster application and ends the session with Taskmaster Server.\u003c/td\u003e\r\n        \u003c/tr\u003e\r\n        \u003ctr\u003e\r\n          \u003ctd\u003e/Session/Logon\u003c/td\u003e\r\n          \u003ctd title=\"http://localhost:82/service/Session/Logon\"\u003e\r\n            \u003ca rel=\"operation\" href=\"help/operations/Logon\"\u003ePOST\u003c/a\u003e\r\n          \u003c/td\u003e\r\n          \u003ctd\u003eInitiates a new session with Taskmaster Server and logs in to the specified application.\u003c/td\u003e\r\n        \u003c/tr\u003e\r\n        \u003ctr\u003e\r\n          \u003ctd\u003e/Session/LogonEx\u003c/td\u003e\r\n          \u003ctd title=\"http://localhost:82/service/Session/LogonEx\"\u003e\r\n            \u003ca rel=\"operation\" href=\"help/operations/LogonEx\"\u003ePOST\u003c/a\u003e\r\n          \u003c/td\u003e\r\n          \u003ctd\u003eInitiates a new session with Taskmaster Server and logs in to the specified application. If loadUserProfile is used with value as true, then the user profile will be returned. Also returns the time zone of the environment under which Taskmaster Server is running. Example: http://localhost/ServicewTM.svc/Session/LogonEx?loadUserProfile=true\u003c/td\u003e\r\n        \u003c/tr\u003e\r\n        \u003ctr\u003e\r\n          \u003ctd\u003e/Statistics/AvgAccuracy/{application}/{startDate}/{endDate}/{startHour}/{dayInterval}\u003c/td\u003e\r\n          \u003ctd title=\"http://localhost:82/service/Statistics/AvgAccuracy/{APPLICATION}/{STARTDATE}/{ENDDATE}/{STARTHOUR}/{DAYINTERVAL}\"\u003e\r\n            \u003ca rel=\"operation\" href=\"help/operations/GetStatsAvgAccuracy\"\u003eGET\u003c/a\u003e\r\n          \u003c/td\u003e\r\n          \u003ctd\u003eThe average percentage of weighted accuracy of page classification and field recognition. Example: http://localhost/ServicewTM.svc/Statistics/AvgAccuracy/TravelDocs/20151003/0/0/0\u003c/td\u003e\r\n        \u003c/tr\u003e\r\n        \u003ctr\u003e\r\n          \u003ctd\u003e/Statistics/AvgTaskTime/{application}\u003c/td\u003e\r\n          \u003ctd title=\"http://localhost:82/service/Statistics/AvgTaskTime/{APPLICATION}\"\u003e\r\n            \u003ca rel=\"operation\" href=\"help/operations/GetStatsAvgTaskTime\"\u003eGET\u003c/a\u003e\r\n          \u003c/td\u003e\r\n          \u003ctd\u003eGets the average time for a task per document. Example: http://localhost/ServicewTM.svc/Statistics/AvgTaskTime/TravelDocs\u003c/td\u003e\r\n        \u003c/tr\u003e\r\n        \u003ctr\u003e\r\n          \u003ctd\u003e/Statistics/BatchAge/{application}\u003c/td\u003e\r\n          \u003ctd title=\"http://localhost:82/service/Statistics/BatchAge/{APPLICATION}\"\u003e\r\n            \u003ca rel=\"operation\" href=\"help/operations/GetStatsBatchAge\"\u003eGET\u003c/a\u003e\r\n          \u003c/td\u003e\r\n          \u003ctd\u003eGets Age of in-progress batches by state sorted in descending order from the oldest. Example: http://localhost/ServicewTM.svc/Statistics/BatchAge/TravelDocs\u003c/td\u003e\r\n        \u003c/tr\u003e\r\n        \u003ctr\u003e\r\n          \u003ctd\u003e/Statistics/BatchByInterval/{application}/{startDate}/{endDate}/{startHour}/{hourInterval}\u003c/td\u003e\r\n          \u003ctd title=\"http://localhost:82/service/Statistics/BatchByInterval/{APPLICATION}/{STARTDATE}/{ENDDATE}/{STARTHOUR}/{HOURINTERVAL}\"\u003e\r\n            \u003ca rel=\"operation\" href=\"help/operations/GetStatsBatchByInterval\"\u003eGET\u003c/a\u003e\r\n          \u003c/td\u003e\r\n          \u003ctd\u003eGet total number of Batches by interval (hour) per task. Example: http://localhost/ServicewTM.svc/Statistics/BatchByInterval/TravelDocs/20151230/0/1/1\u003c/td\u003e\r\n        \u003c/tr\u003e\r\n        \u003ctr\u003e\r\n          \u003ctd\u003e/Statistics/BatchByTask/{application}\u003c/td\u003e\r\n          \u003ctd title=\"http://localhost:82/service/Statistics/BatchByTask/{APPLICATION}\"\u003e\r\n            \u003ca rel=\"operation\" href=\"help/operations/GetStatsBatchByTask\"\u003eGET\u003c/a\u003e\r\n          \u003c/td\u003e\r\n          \u003ctd\u003eGets total number of batches by task. Example: http://localhost/ServicewTM.svc/Statistics/BatchByTask/TravelDocs\u003c/td\u003e\r\n        \u003c/tr\u003e\r\n        \u003ctr\u003e\r\n          \u003ctd\u003e/Statistics/BatchThreshold/{application}/{status}/{threshold}\u003c/td\u003e\r\n          \u003ctd title=\"http://localhost:82/service/Statistics/BatchThreshold/{APPLICATION}/{STATUS}/{THRESHOLD}\"\u003e\r\n            \u003ca rel=\"operation\" href=\"help/operations/GetStatsBatchThreshold\"\u003eGET\u003c/a\u003e\r\n          \u003c/td\u003e\r\n          \u003ctd\u003eGets batches with elapse time in minutes for a task greater than or equal to a threshold. Example: http://localhost/ServicewTM.svc/Statistics/BatchThreshold/TravelDocs/pending/30\u003c/td\u003e\r\n        \u003c/tr\u003e\r\n        \u003ctr\u003e\r\n          \u003ctd\u003e/Statistics/OperatorTime/{application}/{startDate}/{endDate}/{startHour}/{hourInterval}\u003c/td\u003e\r\n          \u003ctd title=\"http://localhost:82/service/Statistics/OperatorTime/{APPLICATION}/{STARTDATE}/{ENDDATE}/{STARTHOUR}/{HOURINTERVAL}\"\u003e\r\n            \u003ca rel=\"operation\" href=\"help/operations/GetStatsOperatorTime\"\u003eGET\u003c/a\u003e\r\n          \u003c/td\u003e\r\n          \u003ctd\u003eGets the amount of time each operator spends to perform tasks that are not automated. Example: http://localhost/ServicewTM.svc/Statistics/OperatorTime/TravelDocs/0/0/0/0\u003c/td\u003e\r\n        \u003c/tr\u003e\r\n        \u003ctr\u003e\r\n          \u003ctd\u003e/Statistics/PagesByInterval/{application}/{startDate}/{endDate}/{startHour}/{hourInterval}\u003c/td\u003e\r\n          \u003ctd title=\"http://localhost:82/service/Statistics/PagesByInterval/{APPLICATION}/{STARTDATE}/{ENDDATE}/{STARTHOUR}/{HOURINTERVAL}\"\u003e\r\n            \u003ca rel=\"operation\" href=\"help/operations/GetStatsPagesByInterval\"\u003eGET\u003c/a\u003e\r\n          \u003c/td\u003e\r\n          \u003ctd\u003eThe number of documents ingested per day.Example: http://localhost/ServicewTM.svc/Statistics/PagesByInterval/TravelDocs/20151202/20151203/2/1\u003c/td\u003e\r\n        \u003c/tr\u003e\r\n        \u003ctr\u003e\r\n          \u003ctd\u003e/Statistics/ScanByInterval/{application}/{startDate}/{endDate}/{startHour}/{hourInterval}\u003c/td\u003e\r\n          \u003ctd title=\"http://localhost:82/service/Statistics/ScanByInterval/{APPLICATION}/{STARTDATE}/{ENDDATE}/{STARTHOUR}/{HOURINTERVAL}\"\u003e\r\n            \u003ca rel=\"operation\" href=\"help/operations/GetStatsScanByInterval\"\u003eGET\u003c/a\u003e\r\n          \u003c/td\u003e\r\n          \u003ctd\u003eThe amount of time in minutes it takes to scan document pages for batch creation per interval.Example: http://localhost/ServicewTM.svc/Statistics/ScanByInterval/TravelDocs/20151003/0/0/0\u003c/td\u003e\r\n        \u003c/tr\u003e\r\n        \u003ctr\u003e\r\n          \u003ctd\u003e/Statistics/TotalCounts/{application}\u003c/td\u003e\r\n          \u003ctd title=\"http://localhost:82/service/Statistics/TotalCounts/{APPLICATION}\"\u003e\r\n            \u003ca rel=\"operation\" href=\"help/operations/GetStatsCounts\"\u003eGET\u003c/a\u003e\r\n          \u003c/td\u003e\r\n          \u003ctd\u003eGets count of Batches, Documents, and Pages. Example: http://localhost/ServicewTM.svc/Statistics/TotalCounts/TravelDocs\u003c/td\u003e\r\n        \u003c/tr\u003e\r\n        \u003ctr\u003e\r\n          \u003ctd\u003e/Transaction/End/{transactionId}\u003c/td\u003e\r\n          \u003ctd title=\"http://localhost:82/service/Transaction/End/{TRANSACTIONID}\"\u003e\r\n            \u003ca rel=\"operation\" href=\"help/operations/TransactionEnd\"\u003eDELETE\u003c/a\u003e\r\n          \u003c/td\u003e\r\n          \u003ctd\u003eEnds the current transaction.\u003c/td\u003e\r\n        \u003c/tr\u003e\r\n        \u003ctr\u003e\r\n          \u003ctd\u003e/Transaction/Execute\u003c/td\u003e\r\n          \u003ctd title=\"http://localhost:82/service/Transaction/Execute\"\u003e\r\n            \u003ca rel=\"operation\" href=\"help/operations/TransactionExecute\"\u003ePOST\u003c/a\u003e\r\n          \u003c/td\u003e\r\n          \u003ctd\u003eExecute rules for a transaction.  Rulesets is a comma separated list of rulesets to run in the order provided. For global rulesets specify the ruleset name with suffix .Rul.dll\u003c/td\u003e\r\n        \u003c/tr\u003e\r\n        \u003ctr\u003e\r\n          \u003ctd\u003e/Transaction/GetFile/{transactionId}/{fileName}/{fileExtension}\u003c/td\u003e\r\n          \u003ctd title=\"http://localhost:82/service/Transaction/GetFile/{TRANSACTIONID}/{FILENAME}/{FILEEXTENSION}\"\u003e\r\n            \u003ca rel=\"operation\" href=\"help/operations/TransactionGetFile\"\u003eGET\u003c/a\u003e\r\n          \u003c/td\u003e\r\n          \u003ctd\u003eGet a file in a transaction using the transaction ID, file name and file extension\u003c/td\u003e\r\n        \u003c/tr\u003e\r\n        \u003ctr\u003e\r\n          \u003ctd\u003e/Transaction/GetFileList/{transactionId}/{mode}\u003c/td\u003e\r\n          \u003ctd title=\"http://localhost:82/service/Transaction/GetFileList/{TRANSACTIONID}/{MODE}\"\u003e\r\n            \u003ca rel=\"operation\" href=\"help/operations/TransactionGetFileList\"\u003eGET\u003c/a\u003e\r\n          \u003c/td\u003e\r\n          \u003ctd\u003eGet a list of files in a transaction using the transaction ID and mode.  Modes { All, New, Modified }\u003c/td\u003e\r\n        \u003c/tr\u003e\r\n        \u003ctr\u003e\r\n          \u003ctd\u003e/Transaction/SetFile/{transactionId}/{fileName}/{fileExtension}\u003c/td\u003e\r\n          \u003ctd title=\"http://localhost:82/service/Transaction/SetFile/{TRANSACTIONID}/{FILENAME}/{FILEEXTENSION}\"\u003e\r\n            \u003ca rel=\"operation\" href=\"help/operations/TransactionSetFile\"\u003ePOST\u003c/a\u003e\r\n          \u003c/td\u003e\r\n          \u003ctd\u003eUpload a file to an transacton using the transaction ID, file name and file extension.  Files may be uploaded using the multipart/form-data content type or by streaming the file.  If streaming the content type should be that of the file being uploaded.  Files may be transferred as a binary string or using base64 encoding.  To use base64 encoding add Content-Transfer-Encoding: base64 to the header if streaming or as the last property in the message part before the file if using multipart/form-data.\u003c/td\u003e\r\n        \u003c/tr\u003e\r\n        \u003ctr\u003e\r\n          \u003ctd\u003e/Transaction/Start\u003c/td\u003e\r\n          \u003ctd title=\"http://localhost:82/service/Transaction/Start\"\u003e\r\n            \u003ca rel=\"operation\" href=\"help/operations/TransactionStart\"\u003eGET\u003c/a\u003e\r\n          \u003c/td\u003e\r\n          \u003ctd\u003eReturns status 201 if successful.  Security can be disabled by setting transactionSecurity = false in the configuration file.  If transactionSecurity = true you must provide the wTmId cookie returned by the Logon endpoint when calling any transaction endpoint. A string value will be returned for the transaction ID.\u003c/td\u003e\r\n        \u003c/tr\u003e\r\n      \u003c/table\u003e\r\n    \u003c/div\u003e\r\n  \u003c/body\u003e\r\n\u003c/html\u003e"
