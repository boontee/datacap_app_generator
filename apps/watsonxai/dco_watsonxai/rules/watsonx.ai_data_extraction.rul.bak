<archive>
	<ruleset id="3" name="watsonx.ai_Data_Extraction" ver="130" modder="admin.1" dt="08/20/24 11:46:09.713 " qi="">
		<rule name="PageRule" id="1" qi="">
			<func name="Extract Values" qi="">
				<a ns="com:Datacap.Libraries.RuleRunnerLogic.Actions" name="rrSet" qi="">
					<p name="Source" type="string" v="-Extract"/>
					<p name="Target" type="string" v="@X.SaveLLMjson"/>
				</a>
				<a ns="net:watsonx_ai.Actions" name="SetMaximumNewTokens">
					<p name="MaximumNewTokens" type="string" qi="The maximum number of tokens." v="4096"/>
				</a>
				<a ns="net:watsonx_ai.Actions" name="AskForPageValuesUsingKeys">
					<p name="Question" type="string" qi="A custom question with identifiers for page text and key placement." v=""/>
					<p name="Format" type="string" qi="Specifies the format of the page text that is sent to the model." v="1"/>
				</a>
				<a name="GoToNextFunction" ns="com:Datacap.Libraries.RuleRunnerLogic.Actions" qi=""/>
			</func>
			<func name="Ask Question" qi="" disabled="y">
				<a ns="net:watsonx_ai.Actions" name="SetMaximumNewTokens">
					<p name="MaximumNewTokens" type="string" qi="The maximum number of tokens." v="4096"/>
				</a>
				<a ns="net:watsonx_ai.Actions" name="SetModel" disabled="y">
					<p name="Model" type="string" qi="The model to use as expected by the LLM.  Smart parameters are supported." v="google/flan-ul2"/>
				</a>
				<a ns="net:watsonx_ai.Actions" name="AskAQuestionUsingPageText">
					<p name="Question" type="string" qi="The question to ask the model." v="What is the invoice number of this document? Provide only the invoice number without any explanation.  Do not provide extra text that says something like &quot;The invoice number is&quot;."/>
					<p name="Target" type="string" qi="A smart parameter expression that identifies the target field or DCO variable." v="@P\Field10"/>
					<p name="Format" type="string" qi="Specifies the format of the page text that is sent to the model." v=""/>
				</a>
				<a name="AskAQuestionUsingPageText" ns="net:watsonx_ai.Actions">
					<p name="Question" type="string" qi="The question to ask the model."/>
					<p name="Target" type="string" qi="A smart parameter expression that identifies the target field or DCO variable."/>
					<p name="Format" type="string" qi="Specifies the format of the page text that is sent to the model."/>
				</a>
				<a ns="net:watsonx_ai.Actions" name="AskAFreeFormQuestion">
					<p name="Question" type="string" qi="The question to ask the model." v="How do you convert feet to meters?"/>
					<p name="Target" type="string" qi="A smart parameter expression that identifies the target field or DCO variable." v="@P\Field11"/>
					<p name="Format" type="string" qi="Specifies the format of the page text that is sent to the model." v=""/>
				</a>
				<a name="GoToNextFunction" ns="com:Datacap.Libraries.RuleRunnerLogic.Actions" qi=""/>
			</func>
			<func name="Stop" qi="">
				<a ns="com:Datacap.Libraries.RuleRunnerLogic.Actions" name="SetReturnValue">
					<p name="ReturnValue" type="string" v="true"/>
				</a>
			</func>
		</rule>
	</ruleset>
