'End Global Vscan Variables
'***************************


Function min(x1,x2)
		
  if IsNumeric(x1) And IsNumeric(x2) Then
    if(x1<x2) then
      min = x1
    else
      min = x2
    end if
  else
    min = x1
  end if

End Function
		
Function ReportError(strMsg)
		
  If Not bAuto Then
    writelog(strMsg)
  End If
  Call Writelog(strMsg)
  ReportError = True

End Function
		
Function PopupRunTimeError(strMsg)
		
  If err.number <> 0 Then
    strPrompt = strMsg & vbCrLf & "Code: " & CStr(Err.number) & vbCrLf & "Description: " & Err.description
    Call ReportError(strPrompt)
    Call Pilot.MsgStatus(strPrompt,0)
    AbortBatch
    
    err.Clear 
    PopupRunTimeError = True   
    Exit Function
  End If
  PopupRunTimeError = False

End Function
		
Function GetLastToken(str,delim)
		
  ' delimiter must be one character
  
  Dim l_String, l_Array

  
  if( Len(delim) > 1 ) Then
    delim = Mid(delim,1,1)
  elseif( Len(delim) = 0 ) Then
    delim = " "
  end if

  l_String = str
  l_Array = Split(l_String, delim, -1, 1)
 
  nLen = Ubound(l_Array)
  GetLastToken = l_Array(nLen)
  Call ErrorHandler("GetLastToken")

End Function
		
Function GetFirstToken(str,delim)
		
  ' delimiter must be one character
  Dim l_String, l_Array

  
  if( Len(delim) > 1 ) Then
    delim = Mid(delim,1,1)
  elseif( Len(delim) = 0 ) Then
    delim = " "
  end if

  l_String = str
  l_Array = Split(l_String, delim, -1, 1)
 
  GetFirstToken = l_Array(0)
  Call ErrorHandler("GetFirstToken")

End Function
		
Function ChangeNameALittle(FullFileName)
		
' PURPOSE: changing the file name in a way : last two character of file name without extension 
' will replace by digits from 00 to 99 get file path and file name.

  nLen = Len(FullFileName)
  For x = nLen To 1 Step -1
    If Mid(FullFileName, x, 1) = "\" Then
      sGetFilePath = Left(FullFileName, x)
      Exit For
    End If
  Next
  sGetFileName = GetLastToken(FullFileName, "\")

'get extension and file name without extension
  sFileExtension = GetLastToken(sGetFileName,".")
  sFileName = GetFirstToken(sGetFileName,".")

' last character of file name without extension replace by digits
  nLenFileName = Len(sFileName)
  If ( nLenFileName > 2 ) Then 
    sNewFileName = Mid(sFileName,1,nLenFileName-1)
  Else
    sNewFileName = ""
  End If
  
  ' check supposed file name
  For i = 1 to 9999
    sSupposeFileName = sNewFileName & i
    'sSupposeFileName = sFileName & i     'appending number to the original filename without replacing last 2 letters of original filename    
    ' check existing file name
    If (Not FileMgr.FileExists(sGetFilePath & sSupposeFileName & "." & sFileExtension)) Then
      Exit For
    end If
  Next 'i
  ChangeNameALittle = sGetFilePath & sSupposeFileName & "." & sFileExtension
  Call ErrorHandler("ChangeNameALittle")

End Function
		
Function GetFilePath(sP)
		
  nLen = Len(sP)
  For x = nLen To 1 Step -1
    If Mid(sP, x, 1) = "\" Then
      GetFilePath = Left(sP, x)
      Exit For
    End If
  Next
  Call ErrorHandler("GetFilePath")

End Function
		
Function LeaveImageFileUntouched(bInter,bDebug)
		
  call oIn.ResetFileOption(FILE_LEAVEALIVE,"")
  LeaveImageFileUntouched = true
  Call ErrorHandler("LeaveImageFileUntouched")

End Function
		
Function RenameImageFileWithExtension(bInter,bDebug,StrParam)
		
' StrParam is the file extension to be used for the copy
  call oIn.ResetFileOption(FILE_RENAME, StrParam)

  RenameImageFileWithExtension = true
  Call ErrorHandler("RenameImageFileWithExtension") 

End Function
		
Function SetImageType(bInter, bDebug, StrParam) 
  
'   String value of the file's identifying extension.  If you are listing multiple types, separate
'   each one with a comma.
'
'   It is not necessary to include a period before each extension. The parameters are not case-sensitive.
  
  StrParam = MetaWord(StrParam)
  StrParam=Replace(StrParam,".","")
  StrParam=Replace(StrParam,Chr(32),"")
  
  SetImageType = False
  
  sExtn = Trim(StrParam) ' LCase(Trim(StrParam))
  
  'Remove period from extension
  sExtn = Replace(sExtn,".","")
  
  If LCase(sExtn)<>"tiff" and LCase(sExtn)<>"tif" and LCase(sExtn)<>"jpg" and LCase(sExtn)<>"jpeg"then 
     'If the input is not a single file type of tiff, tif or jpg, then disable fast mode.
     oOut.SetDoNotOpenInputFiles(True)
     Writelog("special or multiple extensions were provided : setting Fast Mode to TRUE.")
  ElseIf gReinitVScanUponRescan Then
     oOut.SetDoNotOpenInputFiles(False)
  End if
  
  oIn.SetImageExtension(StrParam)
  oOut.SetImageExtension(StrParam)
  SetImageType = True        
  
  Call ErrorHandler("SetImageType")   

End Function

Function SetMultiPageTiff(bInter, bDebug) 
  'Permits the use of multipage source image files.
  oOut.SetMultiPageTiff(True)
  SetMultiPageTiff = true
  Call ErrorHandler("SetMultiPageTiff") 

End Function

Function SetFastMode(bInter, bDebug) 
' Increases speed by preventing the Scan action from opening the files it is scanning.<br/><br/>
'    
'    This action is provided as backwards compatibility to older applications where this action was
'    required to properly enable fast mode for PDF files.  SetImageType will automatically enable
'    fast mode, if it is called with a PDF extension.

 oOut.SetDoNotOpenInputFiles(True)
  SetFastMode = true
  Call ErrorHandler("SetFastMode") 

End Function

Function SearchInSubdirectory(bInter, bDebug) 
'  Looks for source files in sub-directories of the directory you designated with a 
'  SetSourceDirectory action.

  oIn.SearchInSubDirectory(True)
  SearchInSubdirectory = true
  Call ErrorHandler("SearchInSubdirectory") 
 
End Function

Function SetSourceDirectory(bInter, bDebug, SmartParam) 
'
' String value of the directory's name and path. Instead, you can use a Smart Parameter such 
' as @Path to establish the Source Directory's name and path.
    
  Dim StrParam
  Dim oFolder
  
  On Error Resume Next
   
  SetSourceDirectory = False
   
  StrParam = MetaWord(SmartParam)
  If len(Trim(StrParam))=0 Then StrParam=SmartParam
         
  Writelog("looking for:" & StrParam)

  If trim(StrParam)="" Then
    Writelog("Error: Folder '" & StrParam & "' does not exist.")
    SetSourceDirectory = False
  End if
  
  If FileMgr.FolderExists(StrParam)=False Then
    WriteLog("Error: Folder '" & StrParam & "' does not exist")
    nTaskStatus = RetAbort
    Exit Function
  End if

  'Check existing directory and insert DRIVER LETTER: required for Mail Object
      
  Set oFolder = FileMgr.GetFolder(StrParam)
  StrParam = oFolder.Path 
  Set oFolder = Nothing

  oIn.SetSourceDir(StrParam)
  Err.Clear
      
  oOutLook.SetSourceDir(StrParam)
  If err.number <> 0 Then
    WriteLog("Fatal error: Outlook is not running")
    SetSourceDirectory = FALSE
  Else
    SourceDir = StrParam
    SetSourceDirectory = TRUE
  End If  
       

End Function

Function SetMaxImageFiles(bInter, bDebug, SmartParam) 

'    An optional string value specifying the maximum number of files. Smart parameter accepted.
'
'   If you do not enter a value, the task will scan all images in the target folder - and 
'   this action will return True.
 
  Dim StrParam
  Dim strTrimParam  ' Input with leading / trailing space removed
  Dim lParmValue    ' Value as a long

  On Error Resume Next
  StrParam=MetaWord(SmartParam)   
  If len(Trim(StrParam))=0 Then StrParam=SmartParam
  strTrimParam = Trim(StrParam)
  
  'Always return success.  If the parameter value is not a valid integer, then we will just
  'log the problem and use the default value.  Let's set that up as the default condition.
  SetMaxImageFiles = True
  oOut.SetMaxImageFiles(MaxImageFiles)
  
  if len(strTrimParam) = 0 Then
     ' In this one case where no parameter is present, we will use the largest size.
     WriteLog("SetMaxImageFiles: No parameter, using largest value: 32767")
     oOut.SetMaxImageFiles(32767)
     Exit function
  end if   

 ' CInt will cause an error if the value is a number that is bigger than an int.  
 ' We will validate it is a positive integer.
 if (Not IsNumeric(strTrimParam)) Then
    WriteLog("SetMaxImageFiles: Parameter: " & strTrimParam & " is not a number, using default value: " & MaxImageFiles)
    exit function
 end if   

 ' We have some kind of number.  It can be an int or a long.

 if (Len(strTrimParam) > 5) then
    WriteLog("SetMaxImageFiles: Parameter: " & strTrimParam & " is too big, using default value: " & MaxImageFiles)
    exit function
 end if   
 
 ' Might or might not be an int, but it must be a long by now.

 lParmValue = CLng(strTrimParam)    ' Set value to a long to prevent overflow

 if ((lParmValue > 32767) or (lParmValue < 1)) Then
    ' bigger than signed int or 0 or negative
    WriteLog("SetMaxImageFiles: Parameter: " & strTrimParam & " is too big or 0, using default value: " & MaxImageFiles)
    exit function
 end if   
    
 ' We have a valid, positive integer.
 oOut.SetMaxImageFiles( CInt(strTrimParam) )  ' Note, CInt rounds and uses system numeric settings

 Call ErrorHandler("SetMaxImageFiles")

 
End Function

Function DeleteImageFile(bInter, bDebug) 

'A housekeeping action that deletes the current source image file.  A Scan action 
'must follow this action.
 
  On Error Resume Next
  
  Call oIn.ResetFileOption(FILE_DELETE,"")
  DeleteImageFile = True
  
  Call ErrorHandler("DeleteImageFile")

End Function

Function CopyFile(bInter, bDebug, StrParamSP) 

'    <b>1.</b> The String value of the name of the target file system folder.<br/>
'    <b>2.</b> Optional. The file extension you wish to use for each file. If you provide an extension, it must
'    not be preceded by a period.  The action defaults to "tif" if this parameter is blank.<br/>
'    Smart parameters are supported.

  Dim aParam
  Dim StrParam
  
  On Error Resume Next
    
  StrParam = MetaWord(trim(StrParamSP)) 
  writelog("Input after processing smart parameters: '" & StrParam & "'")
  
  aParam = Split(StrParam,",")

  If uBound(aParam) = 1 Then
    call oIn.ResetFileOption(FILE_COPY,  StrParam) 
    CopyFile = true
  Else
    call oIn.ResetFileOption(FILE_COPY,  StrParam & ",tif") 
    CopyFile = true
  End if
  
  Call ErrorHandler("CopyFile") 

End Function

Function SetMailSourceFolder(bInter, bDebug, SmartParam) 
  'String value of the Outlook folder you want to search.

  Dim StrParam
  
  On Error Resume next    
  
  SetMailSourceFolder = False
  
  StrParam=MetaWord(SmartParam)  
  
  If len(Trim(StrParam))=0 Then StrParam=SmartParam
  
  If trim(StrParam) <> "" Then
     oOutLook.InitializeOutlook(StrParam) 
  Else
      ' leave Mail Source folder untouched
    writelog("StrParam is empty, leave Mail Source folder as Inbox")
  End if

  ' we always put result of action in true, because we can manage badly created oOutlook object
  ' by  variable CMailFolder::bInitializeComplete

  SetMailSourceFolder = True
   

End Function

Function Scan(bInter, bDebug) 
  '    Scans a set of waiting Image files, according to the parameters set by earlier actions.<br/><br/>
  '    This is usually the last action in a vScan rule.
  
  On Error Resume Next
  Scan = False
  If gReinitVScanUponRescan Then Writelog "gReinitVScanUponRescan = True"
    
  If cInt(CurrentObj.ObjectType) <> 0 Then
		writelog("The Scan action is required to run at the Batch level.  Returning False.")
		Exit Function	
	End If
  
  If (Not FileMgr.FolderExists(SourceDir)) Then
    If len(trim(SourceDir))=0 then
      writelog("Source Directory is not setup correctly, an empty path exists for this value. Exiting.")
    Else
      writelog("Source Directory '" & SourceDir & "' not Found. Exiting.")
    End if
    Scan = False
    Exit function
  End if  

  If IsAlive(oOutLook) then oOutLook.SaveAttachmentsAndDeleteMail()

  nImages = Ubound(oIn.GetArray())
  If nImages = 32767 Then 
      writelog("Maximum reached. Found " & nImages & " or more image files in Source folder:'" & SourceDir & "'.")
  Else
      writelog("Found " & nImages & " image files in Source folder:'" & SourceDir & "' for the batch.")
  End if
  nMaxImageFiles = oOut.GetMaxImageFiles()
  
  'Get image files
  If cInt(nImages)<>cInt(0) Then 
  
    If bDocumentStructurePresents=TRUE then
      'Set the Expected Pages variable
      DCO.Variable("EP") = cStr(nMaxImageFiles)
    End if

    'Process Image Files
    For i = 1 to min(nImages,oOut.GetMaxImageFiles) 'nImages
      sUnderProcessFile = oIn.GetFile(i)

      Select Case cStr(oOut.Perform(sUnderProcessFile))
        
        Case cStr(PerformPageOk)
            'we will release files at the end
            'oIn.ReleaseFile(sUnderProcessFile) 
        
        Case cStr(PerformPageAbort)
            'oIn.ReleaseFile(sUnderProcessFile) 
            writelog("Files not released - File Processing Aborting.")
            nTaskStatus = RetAbort
            Scan = false
            Exit function
        
        Case cStr(PerformPageFinish)
            'we did not process  oIn.ReleaseFile(sUnderProcessFile) 
            nTaskStatus = RetFinished
            Exit for

        Case Else
            'oIn.ReleaseFile(sUnderProcessFile) 
            writelog("Files not released - Unexpected result from File Processing.")
            Scan = False
            Exit function
      End Select
      
    Next 'i

    If nTaskStatus = RetFinished Then
       writelog("Releasing files...")
       For i = 1 to min(nImages,oOut.GetMaxImageFiles) 'nImages
          sUnderProcessFile = oIn.GetFile(i)
          oIn.ReleaseFile(sUnderProcessFile) 
       Next
       Writelog("Files Released.")
    End if

    Pilot.ExpectedPages = cStr(nImages)
    nTaskStatus = RetFinished

  Else
    nTaskStatus = RetPending

  End if

  Scan = True
  
    Call ErrorHandler("Scan") 

End Function

Function AddDocument(bInter, bDebug) 

'   Places all scanned pages into a single, batch-wide document.
'   This action must be called before the Scan action.<br/><br/>
'
'   The action also adds ED (Expected Documents), AD (Actual Documents), EP (Expected Pages)
'   and AP (Actual Pages) properties to a task's Page file (.xml).<br/><br/>
'
'   This action allows a VScan task to create a batch that has all the same 
'   characteristics of a batch that is created using a standard scan task such as kScan or iScan.
'   It is not required to call this action.  Use this action if your application relies on a
'   document structure on import.

  On Error Resume Next

  AddDocument = False

  If cInt(CurrentObj.ObjectType) <> 0 Then
		writelog("The AddDocument action is required to run at the Batch level. Returning False.")
		Exit Function	
	End If

  Set oSetupObject = DCO.SetupObject

  writelog("Checking Setup DCO for a document structure...")
  nDocs = oSetupObject.NumOfNodes(1)

  If (nDocs >= 1 ) Then '  we suppose there is just one document
    Writelog("Found '" & cstr(nDocs) & "' document structures in current setup DCO.")
    
    If DCO.NumOfChildren = 0 Then
         Set oDoc = DCO.AddChild(1,Pilot.BatchID & ".01" ,-1)
         oDoc.Type = ""   'oDoc.Type=oSetupObject.GetNode(1,0).Name

         DCO.Variable("ED") = cStr(nDocs)
         DCO.Variable("AD") = "0"
         DCO.Variable("EP") = "0"
         DCO.Variable("AP") = "0"
    Else
        Set oDoc = DCO.GetChild(0)
    End if
    
    bDocumentStructurePresents = True
    AddDocument = True
  Else
    Writelog("No document structures found in current setup DCO. No Document structure will be created.")
    bDocumentStructurePresents = false
    AddDocument = false
  End If
  
  Set oSetupObject = Nothing 

End Function

Function SetSortOrder(bInter, bDebug, strParam) 
'   Two comma-separated String values:
'
'    1. Designation of the images' sorting field: ImageName=1, Type=2, DateCreated=3,
'    DateLastAccessed=4, DateLastModified=5, or Size=6.
'    2. Optional: ASC or 1 (Ascending), DESC or 2 (Descending). If you do not include this 
'    parameter, the action defaults to ASC (1).

  Dim bValid
  Dim arParam

  On Error Resume Next

  SetSortOrder = false
  
  strParam=trim(strParam)
  If len(strParam)=0 then
    writelog("Expecting 1 or 2 parameter values. None found.")
    Exit function
  End if
  
  arParam = split(strParam,",")
  if Ubound(arParam) > 1 Then
    writelog("Wrong number of parameters, should be 1 or 2")
    exit function
  end if

  arParam(0)=Trim(cStr(arParam(0)))

  Select Case Ucase(arParam(0))
	Case "NAME","1"
		gSortType = "Name"
 	Case "TYPE","2"
		gSortType = "Type"
	Case "DATECREATED","3"
		gSortType = "DateCreated"
	Case "DATELASTACCESSED","4"
		gSortType = "DateLastAccessed"
	Case "DATELASTMODIFIED","5"
		gSortType = "DateLastModified"
	Case "SIZE","6"
		gSortType = "Size"
	Case Else
		writelog ("first argument has to be one of the names: Name,Type,DateCreated,DateLastAccessed,DateLastModified,Size")
      	Exit function
  End Select
  
  ' Default to assending sort order.
  gSortOrder = "ASC"
  
  If uBound(arParam)=1 Then
    arParam(1)=Trim(cStr(arParam(1)))	
    Select Case uCase(arParam(1))
	Case "DESC","2"
	      gSortOrder = "DESC"
      	writelog("sort order is DESC")
    	Case Else
      	writelog("sort order is ASC")	
    end Select
  end if

  SetSortOrder = true 
    
  
End Function

Function SetAlternateImageNames(NameIndex)
		
  'NOTE: THIS ACTION ISN'T CODED FOR ALL CASES. KEEPING IT PRIVATE UNTIL IT CAN BE FINISHED.
  
  ' <b>0</b> : Sets the naming scheme of the input files to the format used by eDocument Conversion actions.<br/>
  '  Any other input value uses the traditional naming schmeme of TM000001, TM000002, etc.
 
  On Error Resume Next  
 
  If NameIndex="" then NameIndex="0"
  
  If NameIndex="0" then 
     g_bAltDCName=true
  
    'Future oDCName index for nameing convention set here
  End if

  WriteLog("g_bAltDCName = " & g_bAltDCName)

  SetAlternateImageNames = true
  Call ErrorHandler("SetAlternateImageNames")


End Function
		
Function MoveImageFileToDirectory(bInter, bDebug, SmartParam) 
 'The full path to the target location of the Image file.  Smart parameters are supported.
 '
 '   A housekeeping action that moves the current Image file to a location you specify.  The source
 '   image file will be removed from the input directory and moved to the specified directory.
 '   This action is typically used when it is desired to place images into a specific
 '   location for archiving.  A copy of the image will still be placed into the batch directory.
 '
 '   If the target directory already contains a file of the same name, it will give a unique name to the new file.
 '
 '  This action must precede the Scan action.  If MoveImageFileToDirectory is used and the Scan action
 '  is never subsequently called, the file move will not be performed.
 
 Dim StrParam   
  
  On Error Resume Next

  StrParam=Metaword(SmartParam)
  If len(Trim(StrParam))=0 Then StrParam=SmartParam
   
  If trim(StrParam)<>"" Then
    If ( Not FileMgr.FolderExists(StrParam) ) Then
      WriteLog("Fatal error: Folder " & StrParam & " does not exist")
      nTaskStatus = RetAbort
      MoveImageFileToDirectory = False
    Else
    
      ' check existing directory
      ' AND insert DRIVER LETTER : it is needed for Mail Object

      Dim folder
      Set folder = FileMgr.GetFolder(StrParam)
      StrParam = folder.Path 
      Set Folder = Nothing

      call oIn.ResetFileOption(FILE_MOVE, StrParam)

      MoveImageFileToDirectory = True 
    End if
  Else
    WriteLog("MoveImageFileToDirectory: Parameter is not correct.")
    nTaskStatus = RetAbort
    MoveImageFileToDirectory = False
  End if

  Call ErrorHandler("MoveImageFileToDirectory")

End Function
