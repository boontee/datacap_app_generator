Sub InitObjects()

  On Error Resume Next

	Set FileMgr = CreateObject("Scripting.FileSystemObject")
  If IsAlive(FileMgr) then 
     WriteLog("Global FileMgr Object created")
  Else
     WriteLog("Allocation Error: Global FileMg Object missing")
  End if        
  
	Set ImageCtrl = CreateObject("DCIMAGE.DcimageCtrl.1")
  If IsAlive(ImageCtrl) then 
     WriteLog("Global ImageCtrl Object created")
  Else
     WriteLog("Allocation Error: Global ImageCtrl Object missing")
  End if            
  
	Set oConn = CreateObject("ADODB.Connection")
	If IsAlive(oConn) then 
     WriteLog("Global oConn Object created")
  Else
     WriteLog("Allocation Error: Global oConn Object missing")
  End if            
  
	Set CCOCreator=CreateObject("CCO._CCOCreator")
	If IsAlive(CCOCreator) then 
     WriteLog("Global CCOCreator Object created")
  Else
     WriteLog("Allocation Error: Global CCOCreator Object missing")
  End if       
  
  CCOCreator.MaxWaitTime = 5000	' wait up to 5 seconds for CCO to exist
	
	gbDebug = RRState.DebugMode
	gbInteractive = RRState.Interactive
	gbInter = RRState.Interactive

  Set CCO = Nothing
  Set CCO = CreateObject("CCO._CCOCollection")
  If IsAlive(CCO) then 
     WriteLog("Global CCO Object created")
  Else
     WriteLog("Allocation Error: Global CCO Object missing")
  End if            

  'Log the batch xml
  Call Writelog("Pilot XML:" & vbcrlf & Pilot.ExportXML() & vbcrlf)
End sub

Call InitObjects()
  
Sub InitPage()
  'Find current parent page and load CCO if it has a cco file
  Dim oPage
  On Error Resume Next
   
  
  If IsAlive(CurrentObj) then ' ---- Added for Quattro compatibility to fix error described in SPR 23678 (update "7.6.41")
     WriteLog("InitPage")
     Set oPage = CurrentObj
     
     While oPage.ObjectType<>2 and oPage.ObjectType>0
        Set oPage = oPage.Parent    
     Wend
     
     If oPage.ObjectType=0 then Exit Sub
     
     ' Some comments about this loading of the CCO here.
     ' This is loaded every time rules start on a page / field.
     ' Meaning that for every page this is loaded.  So there is a lot of loading here.
     ' If there is only one page in the batch and multiple rules in the task profile, then the same page is loaded over and over again
     ' Not only is this wasted work when the original could be reused, it is making a com call, and we have see problems with com objects
     ' not getting released or running out of memory on large rulesets. It is not know if this code here is a probelm but it might be contributing.
     ' Another issue is that all this work to load the page is mostly useless.  Most actions do not need this page loaded.  The locate action
     ' library needs it and maybe one or two more action libraries need it.  Most of the VB action libraries do not need it and none of the C# actions
     ' need it, yet, the page is loaded over and over.  It would be good to change this so it is only loaded by action libraries that need it.
     ' That will actually reduce a ton of unneeded loads.  The only downside is that there could be someone who wrote a custom action
     ' that needs this loaded.  I have these ideas for that problem.
     ' a) Create a public action to do this load, so if people have a custom action, they could call our action first in the rules.
     ' b) Document how to make this load, so people simply do it in their custom code.
     ' c) Create a SETUP DCO environment variable that can be checked for a value.  If it is set, then the load is performed,
     '    then people who have the custom action can add the variable to their setup DCO.  The down side is we have to check that variable over and over. That means using COM objects again.
     '
     ' One more idea I have is when loading the CCO, check to see if the same CCO is already loaded, that would reduce some unneeded loading, but still, most of the loading will still be unnecessary.
     
     Call LoadCCO(oPage)
     
     Set oCurPage = Nothing  ' I believe this is intended to force an unload.
     Set oCurPage = oPage
  Else
     Call Writelog("CurrentObj is Nothing")     
  End if
  
End Sub
 
Sub LoadCCO(oPage)
  Dim sVar
  Dim strBaseImageName
  Dim bFound

  On Error Resume Next

  bFound=False
  sVar="DATAFILE"
        
  If oPage.FindVariable(sVar)<0 Then sVar="IMAGEFILE"
  
  If oPage.FindVariable(sVar)>=0 Then  				
  
     'Initially it was hardcoded to 3 considering image extension to be always 3 characters. 
     'Modified it with realExt variable which will work for any number of characters in extension.
     Dim aPath
     Dim realExt
     aPath =Split(oPage.ImageName,".")
     Dim l
     l=UBound(aPath)
     'Get the last item of an array which will be the real extenstion of an image.
     realExt = aPath(l)

     Dim filenameAndPath
     filenameAndPath = Left(oPage.Variable(sVar), Len(oPage.Variable(sVar)) - Len(realExt))

     Dim period
     period = "."
     Dim lastchar
     lastchar = right(filenameAndPath,1)
     Call Writelog("Last: " & lastchar & " Ext: '" & realExt & "'")
     
     If ("." = lastchar) Then
         period = ""       ' The period is already there, so do not add it again
     End If
     
     strBaseImageName = filenameAndPath & period & "cco"   ' Build the new path to the CCO file based on the page file name.
     
     If ("ForceCCOReload" = gbLoadedCCO) Then
        gbLoadedCCO = ""
        RRState.OnActionSuccess="Call OnActionSuccess()"  ' Reset to the standard call. Removes the call to gbLoadedCCO = "ForceCCOReload"  Refer to SharedRecognitionTools for more information
        WriteLog("VBSCCOReload")
     End If
        
     'Check if CCO matches Loaded CCO
     If ucase(gbLoadedCCO)=ucase(strBaseImageName) and strBaseImageName<>"" then Exit Sub

     'If Not IsAlive(CCOCreator) then 
        'Writelog ("RRunner LoadCCO: CCOCreator is not alive")
     'End If
    
     Call Writelog("RRunner LoadCCO attempt to load CCO file: '" & strBaseImageName & "'")
     'If FileMgr.FileExists(strBaseImageName) Then
        'Writelog ("RRunner LoadCCO: strBaseImageName exists.")
     'End If

     If FileMgr.FileExists(strBaseImageName) Then
        If Not IsAlive(CCOCreator) then Set CCOCreator=CreateObject("CCO._CCOCreator")
        
        If Not IsAlive(CCOCreator) then
            WriteLog("Error: Could not allocate CCOCreator")
        End If

        If IsAlive(DCLogX) Then
           'WriteLog("Set DCLogX")
           CCOCreator.LogX = DCLogX ' requires debug version of CCOCreator
           If Err.Number <> 0 then WriteLog("Err " & Err.Description)

           If oPage.FindVariable("CCOFILE") >= 0 Then
              'WriteLog("Set MaxWaitTime")
              CCOCreator.MaxWaitTime = 5000	' wait up to 5 seconds for CCO to exist
              If Err.Number <> 0 then WriteLog("Err " & Err.Description)
           End If
        End If
        
        'Writelog ("RRunner LoadCCO: Going to set CCO to Nothing") 
  
        Set CCO=Nothing
                
        CCOCreator.MaxWaitTime = 5000	' wait up to 5 seconds for CCO to exist
        'WriteLog("rrunner loading CCO")
        Set CCO=CCOCreator.Load(strBaseImageName)
        If IsAlive(CCO) Then 'Added for Quattro compatibility SPR# 25101 update 7.6.46
           'Call Writelog("Loaded CCO 1:'" & strBaseImageName & "'" & ", count=" & CCO.Count)
           Writelog ("RRunner LoadCCO: Loaded CCO.")
           if (CCO.Count < 1) then WriteLog("Loaded empty CCO")
           bFound=True
           gbLoadedCCO=strBaseImageName
           Call CCO.SetCurrentPosition(1,1)
        Else
           Writelog ("Error: CCO object Is Nothing")
        End if
    End if
    
    If TrapError("Getting Data File name for " & oPage.Id)=False Then
    End If
       
  End if

   If bFound=False then  
      'create empty cco for pages with no images or data 
      If IsAlive(CCOCreator) then 
         'Writelog ("RRunner LoadCCO: Checking if CCO object is IsAlive.")
         If IsAlive(CCO) then 
            'Call Writelog("RRunner LoadCCO: Old CCO Count is'" & CCO.Count & "'")
            'consider the max CCO count at root level be less than 50000
            If (CCO.Count > 0 And CCO.Count < 50000) then 
               'Writelog ("RRunner LoadCCO: Setting CCO object to Nothing.")
               Set CCO=Nothing

               'block added to try to handle the crash exit during setting CCO to Nothing
               If Err.Number <> 0 then WriteLog("Err " & Err.Description)
            End If   
            
         End If
      End If   
	  
	    'Writelog ("RRunner LoadCCO: CreateObject CCO._CCOCollection")
	    Set CCO=CreateObject("CCO._CCOCollection")
   End If


End Sub

