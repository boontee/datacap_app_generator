Sub InitVscanGlobalObjects() 
  On Error Resume Next

  Set oOutLook = new CMailFolder 
  If Err.number <> 0 Then 
    WriteLog("Couldn't create a MailFolder handler.")
    Err.Clear
  End if
      
  Set oIn = new CScanFilesCollection        
  If Err.number <> 0 Then 
    WriteLog("Couldn't create a Scan File Collection.")
    Call ErrorHandler("class CScanFilesCollection")
    Err.Clear
  End if

  Set oOut = new CProcessImage
  If Err.number <> 0 Then 
    WriteLog("Couldn't create a Process-Image object.")
    Call ErrorHandler("class CProcessImage")
    Err.Clear
  End if
  
  Set oDCName = Createobject("Datacap.DCName.NameLib")
  If Err.number <> 0 Then 
    WriteLog("Couldn't create a DCName object.")
    Set oDCName = nothing
    Err.Clear
  End if

End Sub

