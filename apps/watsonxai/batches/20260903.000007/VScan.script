'***********************************************************************************
'CMailFolder
'***********************************************************************************

Class CMailFolder

  ' copy attachmants from     txtInboxFolder  - mail subfolder in Inbox folder
  '                             |
  '                             V
  '                      to   sImageDir       - regular folder
  ' after processing delete mail
   
  Private OutLook   ' outlook applications
  Private ns              ' MAPI namespace
  Private fs              ' default MAPI folder
  Private fauto           ' subfolder of Inbox, wich includes mesages with image attachments
  Private txtInboxFolder  ' name of subfolder in Inbox folder
  Private sImageDir '
  Private bInitializeComplete

  'Initialize & Terminate ---------------------------------------------- 
  Private Sub Class_Initialize  ' Initialize event.
         
    On Error Resume Next

    bInitializeComplete = False
    ReadDefaultSetup()

    'If setup file is empty we will initialize it from rules
    if (txtInboxFolder="") Then exit Sub
    
    InitializeOutlook(txtInboxFolder)
    bInitializeComplete = True
  End Sub

  Private Sub Class_Terminate    ' Terminate event.
    'do nothing
  End Sub

  'Private methods -----------------------------------------------------
  Public Sub InitializeOutlook(my_InBoxFolder)
           
    Call Writelog("Initializing MailFolder Object")
    txtInboxFolder = my_InBoxFolder
    Set OutLook=CreateObject("Outlook.Application")
    If PopupRuntimeError("Unable to create Outlook object!") Or OutLook is Nothing Then
      Call Writelog("unable to create Outlook object")
      Exit Sub
    End If
    Set ns=OutLook.GetNamespace("MAPI")
    If PopupRuntimeError("Unable to get MAPI namespace!") Or ns Is Nothing Then
      Call WriteLog("Unable to get MAPI namespace!")
      Set OutLook = Nothing
      Exit Sub
    End If

    Set fauto=GetPublicSubFolder(my_InboxFolder)

    If PopupRuntimeError("Unable to get source mail subfolder!") Or fauto Is Nothing Then
      Call Writelog("Unable to get source mail subfolder!" & VbCrLf &_
      "    Check, please, your InboxFolder settings" &_
      " in ini file: "  & txtInboxFolder & VbCrLf &_
      "     must be the same as subfolder name in your Inbox directory")
      Set OutLook = Nothing
      Exit Sub
    End If

'move this function  in action       SaveAttachmentsAndDeleteMail()
    bInitializeComplete = True
    Set OutLook = Nothing
    Call Writelog("completed initialization of MailFolder object")
  End Sub

  Private Sub ReadDefaultSetup

    txtInboxFolder = InboxFolder
    writelog("Read setup settings. Messages with an image attachment are in mail subfolder: " & txtInboxFolder)
    sImageDir = SourceDir
    writelog("Read setup settings. Directory with source images: " & sImageDir)

    ' check existing directory 
    ' AND insert DRIVER LETTER 
    If (Not FileMgr.FolderExists(sImageDir) ) Then
      WriteLog("Folder '" & sImageDir & "' does not exist.")
      Exit Sub
    Else 
      Dim folder
      Set folder = FileMgr.GetFolder(sImageDir)
      sImageDir = folder.Path
      Set folder = Nothing
    End if

  End Sub

  'Public methods -----------------------------------------------------
  Public Function GetPublicSubFolder(strSubFolder)  
   ' strSubFolder - whole path inside Outlook or on Exchange server p1/p2/p3
   ' Function uses global object ns

    on error resume next

    Dim strPassedPath
    strPassedPath = ""
    Dim aPathArray
    Dim arExistingRootFolderNames

    If (strSubFolder ="") Then
      writelog("unable to get Public SubFolder because SubFolder path is empty")
      Set GetPublicSubFolder = Nothing
      Exit Function
    End If
    '   check for trivial error - first symbol is "/" or last symbol is "/"
    If (Mid(strSubFolder,1,1) = "/") Then
      strSubFolder = Right(strSubFolder, Len(strSubFolder) - 1 )
      writelog("Fixed first character in path: the path name should not begin with /")
    End If
    nLen = Len(strSubFolder)
    If (Mid(strSubFolder,nLen,1) = "/") Then
      strSubFolder = Left(strSubFolder, nLen - 1 )
      writelog("Fixed last character in path: the path name should not finish with /")
    End If

    aPathArray = split(strSubFolder,"/")
    If (IsArray(aPathArray)) Then
      nCount = uBound(aPathArray)
      writelog("path piece is " & aPathArray(0))  
      strPassedPath = aPathArray(0)

      ' check all upper level folders
      Set oTopFolders = ns.folders
      if (PopupRunTimeError("Cannot get top level folders")) Then
        Set GetPublicSubFolder = Nothing
        Exit Function             
      end if

      if (oTopFolders is Nothing) then
        writelog("Can not get the topmost level folder list")
        Set GetPublicSubFolder = Nothing
        Exit Function
      end if
 
      if (oTopFolders.Count = 0) then
        writelog("Topmost folder list is empty")
        Set GetPublicSubFolder = Nothing
        Exit Function
      end if

      writelog("Names of top folders")
      for i = 1 to oTopFolders.Count
        strMatched = "not matched"
        'if (lcase(aPathArray(0)) = lcase(oTopFolders.item(i).name)) then strMatched = "matched"
        if (StrComp(aPathArray(0), oTopFolders.item(i).name, 1) = 0) then strMatched = "matched"
        writelog "     " & i &".  " & (oTopFolders.item(i).name) &"    " & strMatched 
      next

      Set moveFolder = ns.Folders(aPathArray(0))
      If (PopupRunTimeError("Cannot get folder "& aPathArray(0))) Then
        Set GetPublicSubFolder = Nothing
        Exit Function             
      End if

      If moveFolder Is Nothing Then
        writelog("ERROR: unable to find path on Exchange Server: '" & strPassedPath & "'")
        Set GetPublicSubFolder = Nothing
        Exit Function
      End If
      For i=1 To uBound(aPathArray)
        writelog("path piece is " & aPathArray(i))
        strPassedPath = strPassedPath & "/" & aPathArray(i) 
        ' check all subfolders
        Set oSubFolders = moveFolder.folders
        if (PopupRunTimeError("Cannot get subfolder list of "& moveFolder.name)) Then
          Set GetPublicSubFolder = Nothing
          Exit Function             
        end if

        if (oSubFolders is Nothing) then
          writelog("Cannot get the sub folder list of "& moveFolder.name)
          Set GetPublicSubFolder = Nothing
          Exit Function
        end if
 
        if (oSubFolders.Count = 0) then
          writelog("subfolder list is empty")
          Set GetPublicSubFolder = Nothing
          Exit Function
        end if

        writelog("Names of subfolders of " & moveFolder.name)
        for k = 1 to oSubFolders.Count
          strMatched = "not matched"
          'if (lcase(aPathArray(i)) = lcase(oSubFolders.item(k).name)) then strMatched = "matched"
          if (StrComp(aPathArray(i), oSubFolders.item(k).name, 1) = 0) then strMatched = "matched"
          writelog "     " & k &".  " & (oSubFolders.item(k).name) &"    " & strMatched 
        next
        
        if (PopupRunTimeError("Cannot manage subfolder list "& moveFolder.name)) Then
          Set GetPublicSubFolder = Nothing
          Exit Function             
        end if

        Set moveFolder = moveFolder.Folders(aPathArray(i))
        if (PopupRunTimeError("Cannot get subfolder "& aPathArray(i))) Then
          Set GetPublicSubFolder = Nothing
          Exit Function             
        end if

        If moveFolder Is Nothing Then
          writelog("ERROR: unable to find out path on Exchange Server: " & strPassedPath)
          Set GetPublicSubFolder = Nothing
          Exit Function
        End If       
      Next
    Else
      writelog("Unable to parse Public SubFolder: " & strSubFolder)
      Set GetPublicSubFolder = Nothing
      Exit Function
    End If  
    Set GetPublicSubFolder = moveFolder
  End Function


  Public Sub SaveAttachmentsAndDeleteMail()
   On Error Resume Next
    If (bInitializeComplete) Then
      For Each Item In fauto.Items
        For Each Att In Item.Attachments 
          sPath = sImageDir & "\" & Att.FileName
          WriteLog("Process attachment " & Att.FileName)
     ' SPR 23510 - check if attachment filename already exists, rename don't overwrite
       If FileMgr.FileExists(sPath) Then
        sExt = FileMgr.GetExtensionName(Att.FileName)
        sBase = Left(Att.FileName, Len(Att.FileName)-Len(sExt))
  
         For j = 1 to 1000
         sPath = sImageDir & "\" & sBase & CStr(j) & "." & sExt
          If Not FileMgr.FileExists(sPath) Then
          Exit For
         End If
        Next 'j
       End If
       Err.Clear
          WriteLog("Save attachment as " & sPath)
       Att.SaveAsFile(sPath)
          If PopupRuntimeError("Unable to save attachment!") Then
            Exit Sub
          End If
          WriteLog("next att")
        Next ' Attachment
        Item.UnRead=False
        Item.Move(ns.GetDefaultFolder(3))  'Delete Mail
        WriteLog("next email")
      Next ' email item
    Else
      Call writeLog("MailFolder class has not been initialized by default.")
    End If
  End Sub 


  Public Sub SetInboxFolder(StrParam)
    if StrParam <> "" Then
      txtInboxFolder = StrParam

      Set fauto = GetPublicSubFolder(txtInboxFolder)

      If PopupRuntimeError("Unable to get source mail subfolder!") Or _
                        fauto is Nothing Then
        WriteLog("Unable to get source mail subfolder !" & VbCrLf &_
        "    Check, please, your InboxFolder settings" &_ 
        "     must be the same as subfolder name in your Inbox directory")
        Exit Sub
      End If
      writelog("Action changes: Messages with an image attachment are in mail subfolder: " & txtInboxFolder)
      bInitializeComplete = True
    else
      writelog("Unable to change mail source folder: StrParam is empty")
    End if
  End Sub

  Public Sub SetSourceDir(StrParam) 
    sImageDir = StrParam 
    writelog("Action changes: Directory with source images: " & sImageDir)
  End Sub

End Class 'CMailFolder
'***********************************************************************************


'***********************************************************************************
'CProcessImage
'***********************************************************************************
Class CProcessImage

  Private chkMultiTif  ' suppose, were is no mix with singleTiff and multiTiff images
  Private chkTree
  Private nMaxImageFiles  ' the number of files per batch
  Private sBatchDir    ' path of batch folder

'  Private nIdx
  Private nScanned  ' the current scanned image
  Private nProcessedFiles ' the current image files
  Private sImageExtension ' default image extension(s)

  Private bProcessAsFile


  'Construction & Destruction -----------------------------------------

  Private Sub Class_Initialize  ' Initialize event.
    writelog("Initializing CProcessImage Object")

    ReadDefaultSetup()
    nScanned = 0  
    bProcessAsFile = 0 'False
    nProcessedFiles = nScanned
  End Sub

  Private Sub Class_Terminate    ' Terminate event.
    'do nothing
  End Sub

 
  'Private methods ----------------------------------------------------

  Private Sub ReadDefaultSetup

    chkMultiTif = MultiPageTif
    writelog("Read setup settings. images are multipage tiff: " & chkMultiTif)

    nMaxImageFiles = MaxImageFiles
    writelog("Read setup settings. Max image files in one batch: " & nMaxImageFiles)

    sImageExtension = ImageExtension ' lcase(ImageExtension)
    if (Not InStr(sImageExtension,".")) Then sImageExtension = "." & sImageExtension
    if (InStr(sImageExtension,",")>4) Then sImageExtension = replace(sImageExtension,",",",.")
    sImageExtension = replace(sImageExtension,",..",",.")
    writelog("Read setup settings. Process images with extension: " & sImageExtension)
         
  End Sub

  '------------------------------------------

  Private Function bAddPageToDCO(sBaseName)
    'COMMENT: works but does not involved yet

    sDir = Pilot.BatchDir
    sTarget = sDir & "\" & sBasename & sImageExtension ' ".tif"
    Set Page = DCO.AddChild(2, sBaseName, -1)
    WriteLog("Page added: " & sBaseName)
    If Not Pilot.IsObjectEmpty(Page) Then
      Page.Type = "Other"
      Page.Status = 49
      Page.ImageName = sTarget
      If Not Page.AddVariableString("PageName", GetPageName(sTarget)) Then
         Call Page.Variable("PageName", GetPageName(sTarget))
      End If
      if (Not Page.AddVariableString("ScanSrcPath",sTarget)) Then
        ' what is for rerun tasks
        call Page.Variable("ScanSrcPath",sTarget)
        writelog("Fixed ScanSrcPath to value " & sTarget)
      end if

      If chkTree Then
        Pilot.ChildrenChanged(DCO)
        Pilot.ActiveObject=Page
      End If

      Set Page=Nothing
      bAddPageToDCO = True
    Else 
      WriteLog("ERROR! Cannot add page to DCO" & vbCrlf & "TASK ABORTS!!!!")
      bAddPageToDCO = False
    End If
  End Function 'bAddPageToDCO

'------------------------------------------

Private Function PerformImagesAsFile(sFile)

  PerformImagesAsFile = false
  If ( trim(sFile) = "" ) Then
     Exit Function
  End If
  
  If nProcessedFiles < nMaxImageFiles then
     WriteLog("PerformImagesAsFile Processing: " & sFile)
     sExtn = sImageExtension ' lcase(sImageExtension)
     If instr(sImageExtension,",")>0 then sExtn = "." &  FileMgr.GetExtensionName(sFile)  ' lcase(FileMgr.GetExtensionName(sFile))        
     
     sDir = Pilot.BatchDir
     sBasename = Left("TM000000", 8 - Len(CStr(nScanned+1))) + CStr(nScanned+1)
   
     If g_bAltDCName=True then 
        WriteLog("Use Alternate Name")
        If IsAlive(oDCName) then
           sBasename = oDCName.GetChildSibling("00000000.", cint(nScanned))  
        Else 
           WriteLog("oDCName is not available")
           sBasename = right("00" & cstr(nScanned+1),2) & "000000"  ' Use traditional namming scheme.
        End if
     End if

     If Not Instr(sExtn,".")=1 then sExtn = "." & sExtn
        
     sTarget = sDir & "\" & sBasename & sExtn 
     writelog("process images as file " & sTarget)
     call FileMgr.copyFile(sFile,sTarget)

     ' if where is no document add page to upper level
     if (oDoc is Nothing) Then
        Set Page = DCO.AddChild(2, sBaseName, -1)
     else
        Set Page = oDoc.AddChild(2, sBaseName, -1)
     end if
     WriteLog("Page added: " & sBaseName)

     If Not Pilot.IsObjectEmpty(Page) Then
        Page.Type = "Other"
        Page.Status = 49
        Page.ImageName = sTarget
        If Not Page.AddVariableString("PageName", GetPageName(sFile)) Then
            Call Page.Variable("PageName", GetPageName(sFile))
        End If
        if (Not Page.AddVariableString("ScanSrcPath",sFile)) Then
           ' what is for rerun tasks
           call Page.Variable("ScanSrcPath",sFile)
           writelog("Fixed ScanSrcPath to value " & sFile)
        end if
        If chkTree Then
           Pilot.ChildrenChanged(DCO)
           Pilot.ActiveObject=Page
        End If
        Set Page=Nothing
     Else 
        WriteLog("ERROR! Cannot add page to DCO" & vbCrlf & "Task Aborting.")
     End If

     nScanned = nScanned + 1
     nProcessedFiles = nScanned
     PerformImagesAsFile = PerformPageOK
  else
     PerformImagesAsFile = PerformPageFinish
     exit Function
  end if

End Function 'PerformImagesAsFile

  '------------------------------------------

  Private Function PerformSinglePage(sFile)

    Dim sPrevError
    Dim sCurError
    Dim nW
    Dim nH
    Dim nbpp
        
    sPrevError = ""
    sCurError = ""
    nW = -1
    nH = -1
    nbpp = -1
        
    On Error Resume Next
  
    PerformSinglePage = PerformPageFalse
    If ( sFile<>"" ) Then
      If ( nProcessedFiles < nMaxImageFiles) Then
        WriteLog("PerformSinglePage Processing: " & sFile)
        sDir = Pilot.BatchDir
        sExtn = "." & FileMgr.GetExtensionName(sFile) ' lcase(FileMgr.GetExtensionName(sFile))
        sBasename = Left("TM000000", 8 - Len(CStr(nScanned+1))) + CStr(nScanned+1)
        sTarget = sDir & "\" & sBasename & sExtn ' sImageExtension ' ".tif"

        Pilot.RepaintPause(100)
               
        ImageCtrl.FileName = sFile

        'Assert
        if (StrComp(ImageCtrl.FileName, sFile, 1) <> 0) Then 
          writelog("Assert: Unable to manage: " & sFile)
          writelog("Custom error: " & ImageCtrl.GetLastMessage())
        end if
      
        'get image info - negative values in log indicates an error
        call ImageCtrl.GetImageInfo(nW, nH, nbpp)
        writelog("Image width: " & nW & " height: " & nH & " Pixel depth: " & nbpp )

        if (LCase(sImageExtension) = ".gif") Then
          call ImageCtrl.Save(sTarget,4) '?????
        Elseif (LCase(sImageExtension) = ".jpg") Then
          call ImageCtrl.Save(sTarget,13) 
        Else
          ' clean up  previous error
          sPrevError = ImageCtrl.GetLastError()
            if ( Not ImageCtrl.Save(sTarget) ) then
                writelog("Unable to save as tif file '" & sTarget & "'")
                sCurError = ImageCtrl.GetLastError()
                writelog("Custom errors: " & sPrevError & VbCrLf & "Current error: " &sCurError)
                
                'assume this is color image
                if ( Not ImageCtrl.Save(sTarget,40)) then
                  writelog("Unable to save as color tif file too" & sTarget )
                  sCurError = ImageCtrl.GetLastError()
                  writelog("Custom error: " & sCurError)
                  PerformSinglePage = PerformPageAbort
                  ImageCtrl.Filename=""
                  ImageCtrl.GetNumPages("")
                  exit function
                end if
            end if
        End If

        ' if where is no document add page to upper level
        if (oDoc is Nothing) Then
          Set Page = DCO.AddChild(2, sBaseName, -1)
        else
          Set Page = oDoc.AddChild(2, sBaseName, -1)
        end if
        WriteLog("Page added: " & sBaseName)

        If Not Pilot.IsObjectEmpty(Page) Then
          Page.Type = "Other"
          Page.Status = 49
          Page.ImageName = sTarget
          If Not Page.AddVariableString("PageName", GetPageName(sFile)) Then
              Call Page.Variable("PageName", GetPageName(sFile))
          End If
          if (Not Page.AddVariableString("ScanSrcPath",sFile)) Then
              ' what is for rerun tasks
              call Page.Variable("ScanSrcPath",sFile)
              writelog("Fixed ScanSrcPath to value " & sFile)
          end if
          If chkTree Then
              Pilot.ChildrenChanged(DCO)
              Pilot.ActiveObject=Page
          End If
          Set Page=Nothing
        Else 
          WriteLog("ERROR! Cannot add page to DCO" & vbCrlf & "TASK ABORTS!!!!")
        End If
           
        nScanned = nScanned + 1
        nProcessedFiles = nScanned
        PerformSinglePage = PerformPageOK
      else
        PerformSinglePage = PerformPageFinish
        ImageCtrl.Filename=""
        ImageCtrl.GetNumPages("")
        exit Function
      End if
    End If
    ImageCtrl.Filename=""
    ImageCtrl.GetNumPages("")
  End Function 'PerformSinglePage

  '------------------------------------------

  Private Function PerformMultiPage(sFile)
    Dim sPrevError
    Dim sCurError
    
    On Error Resume Next

    sPrevError = ""
    sCurError = ""

    PerformMultiPage = PerformPageFalse
    sDir = Pilot.BatchDir

    'slight validation - multipage can be only tiff
    If (LCase(sImageExtension) = ".gif" or LCase(sImageExtension) = ".jpg") Then
      WriteLog("Critical error: Unable to process GIF or JPG files with the Multipage Option enabled.")
      PerformMultiPage = false
      Exit function
    End If

    If ( sFile<>"" ) Then
      If ( nProcessedFiles < nMaxImageFiles) Then
        WriteLog("PerformMultipage Processing: " & sFile)

        Pilot.RepaintPause(100)

        nP = ImageCtrl.GetNumPages(sFile)     'ImageCtrl.FileName = sFile

        If (nP > 1) Then
          WriteLog("Multi-page Tiff with " & nP & " pages detected.")
        Elseif (nP=1) Then
          Writelog("Single page Tiff detected.")
        Else
          Writelog("Error loading Image for page detection.")
        End If

        For i = 0 To nP-1
            ImageCtrl.LoadPage(i)
            sBasename = Left("TM000000", 8 - Len(CStr(nScanned+1))) + CStr(nScanned+1)
            
            If NOT Left(sImageExtension, 1)= "." then   ' Add period if there isn't one.    
                sImageExtension = "." & sImageExtension 
            End if
            
            sTarget = sDir & "\" & sBasename & sImageExtension '".tif"
            nX=0
            nY=0
            nB=0
            Call ImageCtrl.GetImageInfo(nX, nY, nB)
            WriteLog(CStr(nX) & " : " & CStr(nY) & " : " & CStr(nB))

            ' clean up  previous error
            sPrevError = ImageCtrl.GetLastError()
            If Not ImageCtrl.Save(sTarget) Then 
              writelog("Unable to save as tif file" & sTarget )
              ' try to save as color image
              sCurError = ImageCtrl.GetLastError()
              writelog("Custom errors: " & sPrevError & VbCrLf & "Current error: " & sCurError)
              If Not ImageCtrl.Save(sTarget,40) Then 
                WriteLog("Unable to save as color tif file too" & sTarget)
                sCurError = ImageCtrl.GetLastError()
                writelog("Custom error: " & sCurError)
                PerformMultiPage = PerformPageAbort
                ImageCtrl.Filename=""
                ImageCtrl.GetNumPages("")
                exit function
              end if
            end if    

            ' if where is no document add page to upper level
            if (oDoc is Nothing) Then
              Set Page = DCO.AddChild(2, sBaseName, -1)
            else
              Set Page = oDoc.AddChild(2, sBaseName, -1)
            end if

            WriteLog("Page added: " & sBaseName)
            If Not Pilot.IsObjectEmpty(Page) Then
              Page.Type = "Other"
              Page.Status = 49
              Page.ImageName = sTarget
              If Not Page.AddVariableString("PageName", GetPageName(sFile)) Then
                  Call Page.Variable("PageName", GetPageName(sFile))
              End If
              if (Not Page.AddVariableString("ScanSrcPath",sFile)) Then
                ' what is for rerun tasks
                call Page.Variable("ScanSrcPath",sFile)
                writelog("Fixed ScanSrcPath to value " & sFile)
              end if
              If chkTree Then
                Pilot.ChildrenChanged(DCO)
                Pilot.ActiveObject=Page
              End If
              Set Page=Nothing
            Else 
              WriteLog("ERROR! Cannot add page to DCO" & vbCrlf & "Task will Abort")
            End If 

            nScanned = nScanned + 1
        Next ' 
        
        ImageCtrl.GetNumPages("")
        nProcessedFiles = nProcessedFiles + 1
        PerformMultiPage = PerformPageOK
      Else
        PerformMultiPage =PerformPageFinish ' PerformPageFalse
        ImageCtrl.Filename=""
        Exit Function
      End if 
    End If
    ImageCtrl.Filename=""
    ImageCtrl.GetNumPages("")
  End Function 'PerformMultiPage


  'Public methods -----------------------------------------------------

  Public Sub SetMultipageTiff(bParam)
    chkMultiTif = bParam
    if (chkMultiTif) Then
      writelog("Action changes: images are multipage tiff.")
    else
      writelog("Action changes: images are one page tiff.")
    end if
  End Sub
  
  '------------------------------------------

  Public Sub SetDoNotOpenInputFiles(bParam)
    bProcessAsFile = bParam
    if (bProcessAsFile) Then
      writelog("Action changes: image files will be processed without opening as image but as files.")
      If gReinitVScanUponRescan Then chkMultiTif = False
    else
      writelog("Action changes: image files will be processed by opening as image.")
    end if
  End Sub

  '------------------------------------------

  Public Function Perform(sFile)

    If (bProcessAsFile=True) Then
      if (chkMultiTif) Then    
        writelog("Can not use the Multipage tif processing option with the Process-As-File option.")
        Exit Function
      End if
      Perform = PerformImagesAsFile(sFile)
      Exit Function
    End if

    If (chkMultiTif=True) Then
      Perform = PerformMultiPage(sFile)
    Else
      Perform = PerformSinglePage(sFile)
    End if  
  End Function
  
  '------------------------------------------

  Public Function GetMaxImageFiles()
    GetMaxImageFiles = nMaxImageFiles
  End Function  

 '------------------------------------------
 ' Given a filename with a path, return the file name without the file extension
 ' input: c:\dataca\apt\imagedir\abc.xyz.tif
 ' output: abc
  Public Function GetPageName(sFile)

    Dim DotChar
    Dim SlashChar
    DotChar = "."
    SlashChar = "\"

    WriteLog("GetPageName input: " & sFile)  
    GetPageName = sFile
    SlashPos = InStrRev(sFile, SlashChar)
    IF (SlashPos > 0) THEN
        GetPageName = Mid(sFile, SlashPos+1)
    END IF
    DotPos = InStr(GetPageName, DotChar)
    IF (DotPos > 0) THEN
        GetPageName = Mid(GetPageName, 1, (DotPos-1))
    END IF
    WriteLog("GetPageName output: " & GetPageName)
    
  End Function 
  
  '------------------------------------------

  Public Sub SetMaxImageFiles(n)
    nMaxImageFiles = n
    writelog("Action changes: Max image files in one batch: " & nMaxImageFiles)
  End Sub  

  '------------------------------------------

  Public Sub SetImageExtension(strParam)
    writelog("Action changes: Process images with extension: " & sImageExtension)
    sImageExtension = strParam ' lcase(strParam)
  End Sub ' SetImageExtension
  
  Public Sub ResetNumProcessed
    nProcessedFiles = 0
    nScanned = 0
  End Sub

End Class 'CProcessImage


'-----------------------------------------------------------------------------------
'  CScanFilesCollection
'-----------------------------------------------------------------------------------

Class CScanFilesCollection

  Private nFileOption
  Private txtFileMove     'folder to move(copy) files in
  Private mFileExt  ' new file extension

  ' copy or move images  from sImageDir       - regular folder
  '                      or   txtInboxFolder  - mail subfolder in Inbox folder
  '                             |
  '                             V
  '                      to   txtFileMove

  ' and place DCO to      sDir   - batch folder


  Private sImageDir
  Private chkSubDir
  Private sImageExtension 'default image extension
  Private aFiles()


  'Construction & Destruction -----------------------------------------

  Private Sub Class_Initialize  ' Initialize event.
  'FileOptions Constants 
  '   FILE_LEAVEALIVE = 0
  '   FILE_DELETE = 1
  '   FILE_COPY = 2
  '   FILE_MOVE = 3
  '   FILE_RENAME = 4

    Writelog("Initializing SourceFolder Object")
    Redim Preserve aFiles(0)
    ReadDefaultSetup()
     
  End Sub

  '------------------------------------------

  Private Sub Class_Terminate    ' Terminate event.
    Erase aFiles()
  End Sub

  'Private methods ----------------------------------------------------

  Private Sub ReadDefaultSetup

    nFileOption = FileOption

    strFileOption = ""
    Select Case nFileOption
      Case 0  strFileOption = "FILE_LEAVEALIVE"
      Case 1  strFileOption = "FILE_DELETE"
      Case 2  strFileOption = "FILE_COPY"
      Case 3  strFileOption = "FILE_MOVE"
      Case 4  strFileOption = "FILE_RENAME"
      Case Else strFileOption = "unrecognized option"
    End Select
    writelog("Read setup settings. FileOption: " & strFileOption)

    txtFileMove = FileMoveDir
    writelog("Read setup settings. Move files after processing into dir: " & txtFileMove)

    mFileExt = FileExt
    writelog("Read setup settings. Change file extension after processing : " & FileExt)

    chkSubDir = CheckSubDir
    writelog("Read setup settings. Check images into subfolders: " & chkSubDir)

    sImageDir = SourceDir
    writelog("Read setup settings. Directory with source images " & sImageDir)

    sImageExtension = ImageExtension ' lcase(ImageExtension)
    if (Not InStr(sImageExtension,".")) then sImageExtension = "." & sImageExtension
    writeLog("Read setup settings. Process image with extension " & sImageExtension)

    'check existing directory
    If ( Not FileMgr.FolderExists(sImageDir) ) Then
      WriteLog("Folder " & sImageDir & " does not exist.")
      Exit Sub
    Else 
      writeLog("Read setup settings. Directory with source images " & sImageDir)
    End if 
  
  End Sub 'ReadDefaultSetup

  '------------------------------------------

  Private Sub EnumFiles_old(SourceDir) 'defect - deprecate this subroutine because it processes all the files in the input dir, instead of basing on the MaxImageFiles
     ' SourceDir is path to source directory
     ' enumerates only Tiff files 
     ' also looks in subdirectories if option checked 
    Dim fTempName
    Dim fOrigName
    Dim sExtn
    Dim ofile
    
    fTempName = ""
    fOrigName = ""
    sExtn = ""
    
    On Error Resume Next
    Err.Clear
    
    If FileMgr.FolderExists(SourceDir)=True Then
      Set folder = FileMgr.GetFolder(SourceDir)

      i = Ubound(aFiles)  

      'create an ADODB.Recordset and call it rsFSO
      Set rsFSO = CreateObject("ADODB.Recordset")

      'create the various rows of the recordset
      With rsFSO.Fields
        .Append "Name", adWChar, 255
        .Append "Type", adWChar, 255
        .Append "DateCreated", adDate
        .Append "DateLastAccessed", adDate
        .Append "DateLastModified", adDate
        .Append "Size", adInteger
        .Append "TotalFileCount", adInteger
        .Append "Path", adWChar, 255
      End With
      rsFSO.Open()

      Dim sTestExt

      'Iterate through files, add to RS if extn is 'tiff'
      For Each ofile In folder.Files
         sExtn = "." & CStr(FileMgr.GetExtensionName(ofile.Path)) ' lcase(FileMgr.GetExtensionName(ofile.Path)) 
         sTestExt = replace(sExtn,".","")
         If (Instr(1,sImageExtension,sTestExt,1)>0) Or (LCase(right(ofile.Path, 5))=".tiff") Then       
        
            'Add file to RS list
            rsFSO.AddNew
            rsFSO("Name") = ofile.Name
            rsFSO("Type") = ofile.Type
            rsFSO("DateCreated") = ofile.DateCreated
            rsFSO("DateLastAccessed") = ofile.DateLastAccessed
            rsFSO("DateLastModified") = ofile.DateLastModified
            rsFSO("Size") = ofile.Size
            rsFSO("Path") = ofile.Path
            rsFSO.Update        
            ' writelog("Processed file: " & ofile.Name) ' Temp for debugging
          End if  
        
      Next 'ofile

      'Release the File Object
      Set ofile = Nothing
      
      'File I/O lock check
      If Not (rsFSO.EOF And rsFSO.BOF) Then
         rsFSO.MoveFirst()

         While Not rsFSO.EOF
           fOrigName = CStr(rsFSO("Path").Value) ' LCase(rsFSO("Path").Value)
           
           'Set ofile = FileMgr.Getfile(fOrigName)
           
           'call writelog("Enumfiles I/O Lock Check: '" & ofile.Name & "'")
           
           'Release the File Object
           'Set ofile = Nothing
           
           call writelog("Enumfiles I/O Lock Check: '" & fOrigName & "'")
        
           fTempName = CStr(SourceDir & "\" & FileMgr.GetTempName())
          
           Call FileMgr.Copyfile(fOrigName, fTempName,true)           
           If Err.Number<>0 then 
              Writelog("File '" & fOrigName & "' is NOT copied to '" & fTempName & "' Error #:" & Err.Number & " Decription: " & Err.Description) 
           Else
              Writelog("Created Temp file: '" & fTempName & "' from '" & fOrigName & "'.") 
           End if
           
           Call FileMgr.DeleteFile(fOrigName, true)         
           
       '    Dim nTry
       '    nTry=0
       '                          
       '    While FileMgr.FileExists(fOrigName) and Err.Number<>0 and nTry<10
       '       nTry = nTry + 1
       '       wscript.sleep 500
       '       'set WScriptShell = CreateObject("WScript.Shell")
       '       'WScriptShell.Run "Sleep -m " & 500, 0, true
       '    Wend
           
           If Err.Number<>0 then 
              Writelog("File '" & fOrigName & "' is locked and will be ignored. " & " Error #:" & Err.Number & " Decription: " & Err.Description)
              Err.Clear
              rsFSO.Delete 1
           Else
                         
              'Restore the original file name
              Call FileMgr.MoveFile(fTempName, fOrigName)
              If Err.number>0 then
                 Writelog("Failed to Move Temp file '" & fTempName & "' to '" & fOrigName & "'. Error #:" & Err.Number & " Decription: " & Err.Description) 
                 Err.Clear
              End if
           End if
           
           rsFso.MoveNext()
         Wend
      End if
      
      'Release the File Object
      Set ofile = Nothing
             
      'Sort Records by DateCreated Descending
      rsFSO.Sort = gSortType & " " & gSortOrder 

      If Not (rsFSO.EOF And rsFSO.BOF) Then
         rsFSO.MoveFirst()

         While Not rsFSO.EOF And i < 32767
           i = i + 1
           Redim Preserve aFiles(Cint(i))  

           aFiles(i) = rsFSO("Path").Value ' LCase(rsFSO("Path").Value)
           ' Writelog("Sorting: " & rsFSO("Path").Value) ' Temp for debugging
           rsFso.MoveNext()
         Wend
      End if 
      
      'Release the RecordSet
      rsFSO.close()
      Set rsFSO = Nothing
  
      Set fsubcollection = folder.SubFolders      'sub folder collection
  
      If fsubcollection.count <> 0 And Cbool(chkSubDir) Then
        For Each fsub In fsubcollection
          Call EnumFiles_old(fsub.Path)
        Next  
      End If
      
    Else
      WriteLog("Fatal error in EnumFiles: Folder does not exist")
    End if
    
    Set fsubcollection = Nothing
    Set folder = Nothing
    PopupRuntimeError("Error occurred in vscan.EnumFiles")     
  End Sub 'EnumFiles_old

 '------------------------------------------
 ' Major difference between EnumFiles and EnumFiles_old is that the new EnumFiles 
 ' calls ImageFileLocked() while constructing the rsFSO list
  Private Sub EnumFiles(SourceDir)
     ' SourceDir is path to source directory
     ' enumerates only Tiff files 
     ' also looks in subdirectories if option checked 
    Dim fTempName
    Dim fOrigName
    Dim sExtn
    Dim ofile
    
    fTempName = ""
    fOrigName = ""
    sExtn = ""
    
    On Error Resume Next
    Err.Clear
   
    WriteLog("EnumFiles.")
    If FileMgr.FolderExists(SourceDir)=True Then
      Set folder = FileMgr.GetFolder(SourceDir)

      i = Ubound(aFiles)  

      'create an ADODB.Recordset and call it rsFSO
      Set rsFSO = CreateObject("ADODB.Recordset")

      'create the various rows of the recordset
      With rsFSO.Fields
        .Append "Name", adWChar, 255
        .Append "Type", adWChar, 255
        .Append "DateCreated", adDate
        .Append "DateLastAccessed", adDate
        .Append "DateLastModified", adDate
        .Append "Size", adInteger
        .Append "TotalFileCount", adInteger
        .Append "Path", adWChar, 255
      End With
      rsFSO.Open()

      Dim sTestExt
	  Dim fileCount
	  fileCount = i

      'Iterate through files, add to RS if extn is 'tiff'
      For Each ofile In folder.Files
	     if (fileCount >= oOut.GetMaxImageFiles) Then Exit For
         sExtn = "." & CStr(FileMgr.GetExtensionName(ofile.Path)) ' lcase(FileMgr.GetExtensionName(ofile.Path)) 
         sTestExt = replace(sExtn,".","")
         If (Instr(1,sImageExtension,sTestExt,1)>0) Or (LCase(right(ofile.Path, 5))=".tiff") Then       
        
            If (Not ImageFileLocked(ofile.Path)) Then
                'Add file to RS list
                rsFSO.AddNew
                    rsFSO("Name") = ofile.Name
                    rsFSO("Type") = ofile.Type
                    rsFSO("DateCreated") = ofile.DateCreated
                    rsFSO("DateLastAccessed") = ofile.DateLastAccessed
                    rsFSO("DateLastModified") = ofile.DateLastModified
                    rsFSO("Size") = ofile.Size
                    rsFSO("Path") = ofile.Path
                rsFSO.Update        
                fileCount = fileCount + 1                
            Else
                Writelog("File '" & ofile.Name & "' is locked and will be ignored. ")
           End if
         End if         
      Next 'ofile

      'Release the File Object
      Set ofile = Nothing
            
      'Sort Records by DateCreated Descending
      rsFSO.Sort = gSortType & " " & gSortOrder 

      If Not (rsFSO.EOF And rsFSO.BOF) Then
         rsFSO.MoveFirst()

         While Not rsFSO.EOF And i < 32767
           i = i + 1
           Redim Preserve aFiles(Cint(i))  

           aFiles(i) = rsFSO("Path").Value ' LCase(rsFSO("Path").Value)
           rsFso.MoveNext()
         Wend
      End if 
      
      'Release the RecordSet
      rsFSO.close()
      Set rsFSO = Nothing
  
      Set fsubcollection = folder.SubFolders      'sub folder collection

      If fsubcollection.count <> 0 And Cbool(chkSubDir) Then
         WriteLog("EnumFiles - recursive call to subdirectories")
         For Each fsub In fsubcollection
            Call EnumFiles(fsub.Path)
         Next  
      End If
      
    Else
      WriteLog("Fatal error in EnumFiles: Folder does not exist")
    End if
    
    Set fsubcollection = Nothing
    Set folder = Nothing
    PopupRuntimeError("Error occurred in vscan.EnumFiles")     
  End Sub 'EnumFiles
  
   '------------------------------------------

  Private Function ImageFileLocked(sFile)
	ImageFileLocked = True
	If (sFile<>"") Then        
           fTempName = CStr(SourceDir & "\" & FileMgr.GetTempName())
          
           Call FileMgr.Copyfile(sFile, fTempName, true)           
           If Err.Number<>0 then 
              Writelog("ImageFileLocked error: File '" & sFile & "' is NOT copied to '" & fTempName & "' Error #:" & Err.Number & " Decription: " & Err.Description) 
              Err.Clear
              Exit Function
           End if
           
           Call FileMgr.DeleteFile(sFile, true)                   
           If Err.Number<>0 then 
              Writelog("ImageFileLocked error: File '" & sFile & "' is locked. " & " Error #:" & Err.Number & " Decription: " & Err.Description)
              Err.Clear
           Else    
              'Restore the original file name
              Call FileMgr.MoveFile(fTempName, sFile)
              If Err.number>0 then
                 Writelog("ImageFileLocked error: Failed to move temp file '" & fTempName & "' to '" & sFile & "'. Error #:" & Err.Number & " Decription: " & Err.Description) 
                 Err.Clear 
              Else 
                 Writelog("ImageFileLocked: File is not locked. '" & sFile & "'.") 
	         ImageFileLocked = False
              End if 'MoveFile Err.number
           End if 'Delete Err.Number
	End If 'sFile<>""
	
  End Function 'ImageFileLocked
  
  '------------------------------------------

  Private Function ImageFileExists()
  
    ' this function is not in use
    ImageFileExists = False
    For i = 1 To ubound(aFiles)
      If LCase(right(aFiles(i), 4)) = LCase(sImageExtension) Or LCase(right(aFiles(i), 4))="tiff" Then
        ImageFileExists = True
        Exit For
      End If
    Next
  End Function 'ImageFileExists

  '------------------------------------------

  Private Sub ProcessFileOption(sFile)

    PopupRunTimeError("Cleanup error before entries in ProcessFileOption")
    On Error Resume Next
    
    If (sFile<>"") Then
      Dim oFile
      Set oFile=FileMgr.GetFile(sFile)
       
      writelog("Process file " & sFile & " with option " & nFileOption)
      Select Case nFileOption
      
        Case FILE_LEAVEALIVE  
           'do nothing - just will create flag files with ext ".___"
           WriteLog("Process FileOption = Do Nothing")

        Case FILE_DELETE
          WriteLog("Process FileOption = Deleting Source file")
          oFile.Delete
          If PopupRunTimeError("Error deleting source file") Then
            Set oFile = Nothing
            Exit Sub
          End If
          
        Case FILE_COPY 
          sPath = txtFileMove
          sExt = mFileExt
          If Left(sExt, 1) <> "." Then
            sExt = "." & sExt
          End If

          WriteLog("Process FileOption = Copy source file " & oFile.Path)
          WriteLog("to folder " & txtFileMove)
          WriteLog( "Change ext to: " & sExt)
      
             'Create new file path in source directory with new file extension
          lFileName = FileMgr.GetFileName(oFile.Path)

          If LCase(Right(lFileName, 4)) = LCase(sImageExtension) Then
            lFileName = Replace(lFileName, sImageExtension, sExt)
          Elseif LCase(Right(lFileName, 5)) = ".tiff" Then
            lFileName = Replace(lFileName, ".tiff", sExt)
          End if
      
          sPath = sPath & "\" & lFileName

          'Check if file with the same name is exists
          If ( Not FileMgr.FileExists(sPath) ) Then      
            oFile.Copy(sPath)
          Else
            sSupposeFileName = ChangeNameALittle(sPath)
            oFile.Copy( sSupposeFileName )
            WriteLog("file Exists: " & sPath)
            WriteLog("try to copy in another file: " & sSupposeFileName )
          End if
        
          If PopupRunTimeError("Error copying source file to " & sPath) Then
            Set oFile = Nothing
            Exit Sub
          End If
  'd'      oFile.Delete
  
        Case FILE_MOVE
           WriteLog("Process FileOption = Move Source File " & vbCrlf & txtFileMove)

           'Check if file with the same name is exists
           If ( Not FileMgr.FileExists(txtFileMove & "\" & oFile.Name) ) Then      
              Call oFile.Move(txtFileMove & "\")              
           Else              
               WriteLog("File Exists:" & txtFileMove & "\" & oFile.Name)
              sSupposeFileName = ChangeNameALittle(txtFileMove & "\" & oFile.Name)
              oFile.Move(sSupposeFileName)  
              WriteLog("Try move in another file:" & sSupposeFileName )
           End if

           If PopupRunTimeError("Error moving source file to: " & txtFileMove & "\") Then
              Set oFile = Nothing
              Exit Sub
           End If
          
        Case FILE_RENAME
             WriteLog("Process FileOption = Rename source file with extension " & mFileExt )
          sPath = oFile.Path ' LCase(oFile.Path)
          sExt = mFileExt
          If Left(sExt, 1) <> "." Then
            sExt = "." & sExt
          End if

             'changing file name extension
          If LCase(Right(sPath, 4)) = LCase(sImageExtension) Then
            sPath = Replace(sPath, sImageExtension, sExt)
          Elseif LCase(Right(sPath, 5)) = ".tiff" Then
            sPath = Replace(sPath, ".tiff", sExt)
          End If

             'check if file with the same name is exists
             If ( Not FileMgr.FileExists(sPath) ) Then
            oFile.Move(sPath)
             Else
            sSupposeFileName = ChangeNameALittle(sPath)
            oFile.Move( sSupposeFileName )
               WriteLog("file Exists: " & sPath & VbCr & "try to copy in another file: " & sSupposeFileName)
          End If

          If PopupRunTimeError("Error renaming source file") Then
            Set oFile = Nothing
            Exit Sub
          End If
        
      End Select
    End If
    
    Set oFile = Nothing
    
  End Sub

  '------------------------------------------

  Function IsExternalArrayHere
    If (IsArray(extFileArray)) then
      nextCount = uBound(extFileArray)
      IsExternalArrayHere = True
    Else
      IsExternalArrayHere = False
    End If
    End Function

  'Public methods -----------------------------------------------------


  Public Function GetArray
    If gReinitVScanUponRescan Then
      ReDim aFiles(0)
      Call oOut.ResetNumProcessed()
    End If
  
    'Populate file collection Array
    If (Not IsExternalArrayHere) Then
      EnumFiles(sImageDir) 'Read image files from source directory
    Else
      ReDim aFiles(uBound(extFileArray)+1)
      for i=0 to uBound(extFileArray)
        aFiles(i+1) = extFileArray(i)
      next ' i
    end if
    GetArray = aFiles
  End Function
  
  '------------------------------------------
  
  Public Function GetFile(i)
    if (IsNumeric(i)) Then
      if ( ( i > uBound(aFiles)) or (i< 0) ) Then
        PopupRunTimeError("Numeric value of GetFiles is wrong: " & i)
        GetFile=""
      Else
        if (IsEmpty(aFiles)) Then
          GetFile = ""
        else 
          GetFile = aFiles(i)
        End If
      end if
    else
      PopupRunTimeError("Argument of GetFiles is not numeric")
      GetFile=""
    end if
  End Function

  '------------------------------------------

  Public Sub ReleaseFiles
    PopupRunTimeError("Cleanup error before entries in ReleaseFiles")
    Err.Clear

    For i = 1 To ubound(aFiles)
      ProcessFileOption(aFiles(i))
    Next 'i
  End sub

  '------------------------------------------

  Public Sub ReleaseFile(sPath)

    PopupRunTimeError("Cleanup error before entries in ReleaseFile sPath")
    Err.Clear
     If ( sPath <> "" )   Then
        WriteLog("Start release file: " & sPath) 'd'
      ProcessFileOption(sPath)
    End if 
  End sub

  '------------------------------------------

  Public Sub SearchInSubDirectory(bSubDir)
  
    If (bSubDir) Then
      chkSubDir = 1
    Else
      chkSubDir = 0
    End if
    
    Redim Preserve aFiles(0)

  End Sub

  '------------------------------------------

  Public Sub ResetFileOption(nFOption, strParam)

    If ( IsNumeric(nFOption) ) Then    
      if( nFOption = FILE_LEAVEALIVE) Then 
        nFileOption = FILE_LEAVEALIVE
        'we do not worry about strParam
        WriteLog("Reset FileOption: leave image files untouched")    

      elseif( nFOption = FILE_DELETE ) Then
        'we do not worry about strParam
        nFileOption = FILE_DELETE
        WriteLog("Reset FileOption: delete image files")    

      elseif( nFOption = FILE_COPY ) Then
        Dim aParams,lFolder,lExtension
        'we propose strParam is extention of copy =mFileExt
        'Folder to copy files to (1st param). Extension to use (2nd param)
        'Note params are CSV

        aParams = Split(strParam,",")
        lFolder = aParams(0)
        lExtension = aParams(1)

        ' we validate extension
     
        if (trim(lExtension)<>"") Then
          lExtension = trim(lExtension)
          nLen = Len(lExtension)
          For x = nLen To 1 Step -1
          If Mid(lExtension, x, 1) = "." Then
            lExtension = Right(sP, x) 
            Exit For
          End If
        Next

        nLen = Len(lExtension)
        if (nLen > 3) Then nLen = 3 
          mFileExt = left(lExtension,nLen)
        end if   
    
        'if Folder parameter left blank defaults to source folder (left txtFileMove)
        If ( trim(lFolder) <> "" ) then 
         ' we validate folder
          If Not FileMgr.FolderExists(lFolder) Then 
            writelog ("ResetFileOption: folder for move to " & lFolder & " does not exist")
          Else
            txtFileMove = lFolder
          End if
        Else
          lFolder = sImageDir
          txtFileMove = lFolder
        End if

        nFileOption = FILE_COPY
        WriteLog("Reset FileOption: Copy files to folder " & lFolder & " with extension: " & mFileExt)

      Elseif ( nFOption = FILE_MOVE ) Then
        'we propose strParam is directory   =txtFileMove
        ' make shure that directory exists
        If (trim(strParam) <> "") Then
          strParam = trim(strParam)
          If Not FileMgr.FolderExists(strParam) Then
             'check initial folder exists
             Writelog ("ResetFileOption: folder for move in " & strParam & " does not exist" & VbCr & "left initial folder for move in" & txtFileMove)         
          Else
             txtFileMove = strParam  
          End if
        End if
        nFileOption = FILE_MOVE

      Elseif ( nFOption = FILE_RENAME ) Then
        'we propose strParam is new file extension
        If (trim(strParam) <> "") Then
          mFileExt = trim(strParam)
          WriteLog("Reset FileOption: Rename files with extension: " & mFileExt)
        Else
          WriteLog("Reset FileOption: WARNING file extension is not set, used default " & mFileExt)
        End if
        nFileOption = FILE_RENAME

      Else
        writelog("Warning: in ResetFileOption wrong numeric value:" & nFOption & VbCr & "will used -=File unchanged=- (0) instead")
        'Another possibility - dont change options
        nFileOption = FILE_LEAVEALIVE
      End if
      
    Else
      writelog("Warning: in ResetFileOption wrong non numeric value :" & nFOption & VbCr & "will used -=File unchanged=- (0) instead")
      nFileOption = 0
    End if
    
    Writelog("Action : ResetFileOption sets nFileOption = " & nFileOption)

  End Sub ' ResetFileOption

  '------------------------------------------

  Public Sub SetSourceDir(StrParam)
    sImageDir = StrParam
    writelog("Action changes: Directory with source images: " & sImageDir)
  End Sub

  '------------------------------------------

  Public Sub SetImageExtension(StrParam)
    sImageExtension = strParam ' lcase(strParam)
  End Sub


End Class 'CScanFilesCollection
